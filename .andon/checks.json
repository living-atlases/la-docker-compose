{
  "_comment": [
    "scripts/validate-config-gen.sh used to be the rule for templates. It needs ~10 min",
    "(it runs a full ansiblew render plus `docker compose config`) and the hook kills it",
    "at 300s, so the rule could never go green -- and its check 3 is red at baseline",
    "anyway (localhost in two DB URIs, unchanged since before this work). It stays a",
    "manual check. What replaces it here is strictly more discriminating per second:",
    "check-jinja-syntax parses every template, test-compose-includes proves every",
    "compose include has a task that writes it, and the molecule scenarios RENDER the",
    "real templates with real facts and cross-check that no depends_on names a service",
    "no include provides, and that the bake targets asked for are targets the bake file",
    "defines. ~2 min for all of it."
  ],
  "rules": [
    {
      "match": [
        "roles/la-compose/templates/**/*.j2",
        "roles/la-compose/tasks/**/*.yml",
        "roles/la-compose/defaults/main.yml",
        "molecule/**/*.yml"
      ],
      "run": "python3 scripts/check-jinja-syntax.py && bash scripts/test-compose-includes.sh && VENV_MOLECULE=.venv-molecule .venv-molecule/bin/molecule test -s unit && VENV_MOLECULE=.venv-molecule .venv-molecule/bin/molecule test -s multihub"
    },
    {
      "match": [
        "scripts/apply-topology.py",
        "scripts/test-topologies.sh",
        "scripts/test-hub-baseline.sh",
        "topologies/**",
        "playbooks/validate-topology.yml"
      ],
      "run": "VENV_MOLECULE=.venv-molecule bash scripts/test-topologies.sh && VENV_MOLECULE=.venv-molecule bash scripts/test-hub-baseline.sh"
    },
    {
      "match": [
        "scripts/verify-deployment.sh",
        "scripts/test-verify-deployment.sh"
      ],
      "run": "bash scripts/test-verify-deployment.sh"
    },
    {
      "match": [
        "ala-install/ansible/roles/bie-hub/templates/bie-hub-config.yml.j2",
        "scripts/test-bie-hub-container-paths.sh"
      ],
      "run": "bash scripts/test-bie-hub-container-paths.sh"
    },
    {
      "match": [
        "ala-install/ansible/roles/nginx_vhost/tasks/main.yml",
        "scripts/test-nginx-vhost-stale-fragments.sh"
      ],
      "run": "bash scripts/test-nginx-vhost-stale-fragments.sh"
    },
    {
      "match": [
        "roles/la-compose/tasks/register-shared-vhost-stubs.yml",
        "scripts/test-nginx-vhost-loop-var.sh"
      ],
      "run": "bash scripts/test-nginx-vhost-loop-var.sh"
    },
    {
      "match": [
        "roles/la-compose/templates/docker-compose/services/biocache-hub.yml.j2",
        "roles/la-compose/templates/docker-compose/services/bie-hub.yml.j2",
        "roles/la-compose/templates/docker-compose/services/regions.yml.j2",
        "scripts/test-hub-context-path.sh"
      ],
      "run": "bash scripts/test-hub-context-path.sh"
    },
    {
      "match": [
        "scripts/refresh-biocache-fields.sh",
        "scripts/test-refresh-biocache-fields.sh"
      ],
      "run": "bash scripts/test-refresh-biocache-fields.sh"
    },
    {
      "match": [
        "scripts/hub-inventory-args.sh",
        "scripts/test-hub-inventory-args.sh"
      ],
      "run": "bash scripts/test-hub-inventory-args.sh"
    },
    {
      "match": [
        "scripts/check-nginx-duplicate-server-names.sh",
        "scripts/test-nginx-duplicate-server-names.sh"
      ],
      "run": "bash scripts/test-nginx-duplicate-server-names.sh"
    },
    {
      "match": [
        "roles/la-compose/tasks/stage-branding-source.yml",
        "scripts/test-branding-submodules.sh",
        "roles/la-compose/templates/docker-compose/infrastructure/branding.yml.j2"
      ],
      "run": "bash scripts/test-branding-submodules.sh"
    },
    {
      "match": [
        "scripts/wait-for-health.sh",
        "scripts/test-wait-for-health-converge.sh",
        "scripts/fixtures/wait-for-health-*/**"
      ],
      "run": "bash scripts/test-wait-for-health-converge.sh"
    },
    {
      "match": [
        "roles/la-compose/tasks/generate-compose.yml",
        "scripts/test-nginx-conf-dir-artifact.sh"
      ],
      "run": "bash scripts/test-nginx-conf-dir-artifact.sh"
    },
    {
      "match": [
        "roles/la-compose/files/remove-file-mount-artifacts.py",
        "scripts/test-file-mount-artifacts.sh"
      ],
      "run": "bash scripts/test-file-mount-artifacts.sh"
    },
    {
      "match": [
        "roles/la-compose/files/recreate-drifted-services.sh",
        "scripts/test-recreate-drifted-services.sh"
      ],
      "run": "bash scripts/test-recreate-drifted-services.sh"
    },
    {
      "match": [
        "roles/la-compose/tasks/sds-data-permissions.yml",
        "roles/la-compose/tasks/sds-data-fixups.yml",
        "scripts/test-sds-data-permissions.sh"
      ],
      "run": "VENV_MOLECULE=.venv-molecule bash scripts/test-sds-data-permissions.sh"
    },
    {
      "match": [
        "ala-install/ansible/roles/sensitive-data-service/tasks/docker-tasks.yml",
        "scripts/test-sds-layers-fallback.sh"
      ],
      "run": "VENV_MOLECULE=.venv-molecule bash scripts/test-sds-layers-fallback.sh"
    },
    {
      "match": [
        "roles/la-compose/tasks/artifact-fetch-start.yml",
        "roles/la-compose/tasks/artifact-fetch-finish.yml",
        "scripts/test-artifact-fetch.sh"
      ],
      "run": "VENV_MOLECULE=.venv-molecule bash scripts/test-artifact-fetch.sh"
    },
    {
      "match": [
        "roles/docker-housekeeping/templates/containerd-gc.sh.j2",
        "roles/docker-housekeeping/defaults/main.yml",
        "scripts/test-containerd-gc-deploy-guard.sh"
      ],
      "run": "VENV_MOLECULE=.venv-molecule bash scripts/test-containerd-gc-deploy-guard.sh"
    },
    {
      "match": [
        "roles/la-compose/templates/heap-budget.j2",
        "scripts/test-heap-budget.sh"
      ],
      "run": "VENV_MOLECULE=.venv-molecule bash scripts/test-heap-budget.sh"
    },
    {
      "match": [
        "roles/la-compose/tasks/build-images.yml",
        "scripts/test-compose-pull-policy.sh"
      ],
      "run": "VENV_MOLECULE=.venv-molecule bash scripts/test-compose-pull-policy.sh"
    },
    {
      "match": [
        "ansible-constraints.txt",
        "scripts/test-ansible-version-pin.sh",
        "scripts/setup-molecule.sh"
      ],
      "run": "bash scripts/test-ansible-version-pin.sh"
    },
    {
      "match": [
        "scripts/validate-healthcheck-commands.sh",
        "scripts/test-healthcheck-probe-cache.sh"
      ],
      "run": "bash scripts/test-healthcheck-probe-cache.sh"
    }
  ],
  "ignore": [
    "Jenkinsfile",
    "inventories/testing/**",
    "e2e/**"
  ]
}
