---
# ansible-lint configuration for la-docker-compose.
#
# Goal: a run that exits 0, so a non-zero exit means something new is broken.
# Everything silenced below is a deliberate, documented decision — not a way to
# make an inconvenient finding disappear.
#
# Run it through scripts/validate-local.sh, which uses the ansible-lint from
# .venv-molecule (see scripts/setup-molecule.sh). The distro-packaged
# ansible-lint bundles its own ansible-core, which does not match the system
# `ansible` CLI, and aborts before linting anything.
#
# Linting needs ala-install/ansible/roles on ANSIBLE_ROLES_PATH so that
# `import_role: name: docker` in roles/la-compose/tasks/main.yml resolves;
# validate-local.sh sets it. Without it, two unskippable syntax-check[specific]
# failures make a green run impossible.

exclude_paths:
  # Upstream ALA roles: on the roles path for resolution, but not ours to
  # restyle. Linting them adds ~600 findings we would never act on.
  - ala-install/
  - .venv-molecule/
  # Autogenerated by the la-toolkit generator; never hand-edited.
  - inventories/
  - e2e/
  - .git/

# ─────────────────────────────────────────────────────────────────────────────
# Silenced: style-only, no behavioural risk.
# ─────────────────────────────────────────────────────────────────────────────
skip_list:
  # ~487 findings. Rewriting every `copy:` to `ansible.builtin.copy:` across ~93
  # task files of a production deployment repo is a large purely cosmetic diff
  # with real review cost. Doable in one mechanical `ansible-lint --fix` commit
  # if we ever need collection-name disambiguation.
  - fqcn

  # ~54 findings. Variables are shared with ala-install on purpose
  # (docker_compose_data_dir, cas_hostname, …). Prefixing them with the role
  # name would break the contract with upstream roles and with the inventories
  # the generator emits.
  - var-naming[no-role-prefix]

  # NOTE: do not put the bare `yaml` rule in this list. ansible-lint disables
  # --fix entirely when `yaml` is skipped ("no files can be modified because
  # 'yaml' is in 'skip_list'"), which silently makes every autofix a no-op.
  # Silence individual yaml[...] sub-rules via warn_list instead.

  # Role directories are la-compose / la-volumes. The rule wants no dashes; the
  # names are referenced from ala-install, the generator and every inventory.
  - role-name

  # Cosmetic: key ordering within a task, name capitalisation, Jinja not last in
  # a name, spacing inside Jinja expressions.
  - key-order[task]
  - name[casing]
  - name[template]
  - jinja[spacing]

# ─────────────────────────────────────────────────────────────────────────────
# Reported but non-blocking: a genuine backlog, not noise.
#
# These are real code-quality signals in a repo that has already been bitten by
# silent failures, so they stay visible instead of being skipped. They are
# warn_list only because ~54 pre-existing instances would otherwise make a green
# run impossible. Spot-checked when this config was written: the pipes that
# matter (the mysqldump/mongodump/pg_dumpall in pre-deploy-backup.yml) already
# use `set -o pipefail`; the flagged ones are `… || true` guards and a prune
# pipeline. Ratchet these into the blocking set as each family reaches zero.
# ─────────────────────────────────────────────────────────────────────────────
warn_list:
  - no-changed-when          # 22 — command/shell tasks always report "changed"
  - risky-shell-pipe         # 14 — shell pipes without `set -o pipefail`
  - ignore-errors            #  8 — `ignore_errors: true` instead of `failed_when`
  - risky-file-permissions   #  7 — file/copy without an explicit `mode`
  - command-instead-of-module  # 2 — shelling out where a module exists
  - complexity[tasks]        #  1 — generate-compose.yml has 234 tasks

  # yamllint owns YAML style here: validate-local.sh runs it separately against
  # .yamllint and it is green. These two are the only disagreements: yamllint
  # deliberately downgrades them to warnings (space-only lines inside `msg: |`
  # block scalars are valid YAML), ansible-lint treats them as failures.
  - yaml[line-length]        # 32 — >160 chars, mostly Jinja that wraps badly
  - yaml[trailing-spaces]    #  3 — inside literal block scalars, intentional
  - yaml[comments]           #  1 — commented-out task block
