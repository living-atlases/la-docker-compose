{
  "description": "2 hosts, Austria-style: portal front-ends (records/species/regions) split by PATH under ONE shared hostname across both hosts, instead of each on its own subdomain (host1=records, host2=species+regions). Otherwise identical to 2host. Exercises the cross-host shared-vhost stub proxying mechanism (la-compose nginx_shared_vhost_topology / register-shared-vhost-stubs.yml) for the PORTAL.",
  "hosts": [
    "host1",
    "host2"
  ],
  "services": {
    "cas": "host1",
    "collectory": "host1",
    "ala_hub": "host1",
    "biocache_service": "host1",
    "ala_bie": "host2",
    "bie_index": "host1",
    "lists": "host1",
    "logger": "host1",
    "alerts": "host1",
    "branding": "host1",
    "gatus": "host1",
    "solrcloud": "host2",
    "zookeeper": "host2",
    "cassandra": "host2",
    "images": "host2",
    "namematching_service": "host2",
    "spatial": "host2",
    "doi": "host2",
    "data_quality": "host2",
    "sds": "host2",
    "sensitive_data_service": "host2",
    "pipelines": "host2",
    "spark": "host2",
    "hadoop": "host2",
    "airflow": "host2",
    "regions": "host2"
  },
  "skip_services": [
    "spatial",
    "spatial-service",
    "geoserver",
    "geonetwork",
    "doi-service",
    "data_quality_filter_service",
    "sds",
    "sensitive-data-service",
    "pipelines",
    "spark",
    "hadoop",
    "regions"
  ],
  "shared_hostname": {
    "portal-shared.l-a.site": {
      "ala_hub": "/records",
      "ala_bie": "/species",
      "regions": "/regions"
    }
  }
}
