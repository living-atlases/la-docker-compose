{
  "description": "1 host, like 1host, but it DEPLOYS namematching-service and runs it with 2 replicas and the nginx replica drop-in. The only variant where a replicated service can be seen in a real deployed portal: every other topology that deploys namematching-service has 2 hosts or more, where generate-compose refuses replicas (replicating drops the published host port, which is how a consumer on another host reaches it). TASK-115.",
  "hosts": [
    "host1"
  ],
  "services": {
    "cas": "host1",
    "collectory": "host1",
    "ala_hub": "host1",
    "biocache_service": "host1",
    "ala_bie": "host1",
    "bie_index": "host1",
    "images": "host1",
    "lists": "host1",
    "logger": "host1",
    "alerts": "host1",
    "branding": "host1",
    "gatus": "host1",
    "solrcloud": "host1",
    "zookeeper": "host1",
    "cassandra": "host1",
    "spatial": "host1",
    "doi": "host1",
    "data_quality": "host1",
    "sds": "host1",
    "sensitive_data_service": "host1",
    "namematching_service": "host1",
    "pipelines": "host1",
    "spark": "host1",
    "hadoop": "host1",
    "airflow": "host1",
    "regions": "host1"
  },
  "skip_services": [
    "spatial",
    "spatial-service",
    "geoserver",
    "geonetwork",
    "doi-service",
    "data_quality_filter_service",
    "sds",
    "sensitive-data-service",
    "pipelines",
    "spark",
    "hadoop",
    "regions"
  ],
  "extra_vars": {
    "namematching_service_replicas": 2,
    "docker_nginx_replica_failover": true
  }
}
