# Airflow image for the pipelines-airflow NO-AWS overlay.
# Adds the providers the DAGs import + docker CLI (to `docker exec la_pipelines`).
ARG AIRFLOW_VERSION=2.10.3
FROM apache/airflow:${AIRFLOW_VERSION}-python3.11

USER root
# docker CLI only (uses the host daemon via the mounted socket).
#
# Two packages are force-upgraded over whatever the pinned base image froze:
#  - libbrotli1 for CVE-2026-111497 (brotli decoder OOB write; fixed in
#    1.0.9-2+deb12u1): curl and libcurl in the base image link it.
#  - ca-certificates for the eMudhra distrust (2026-10-17), whose intermediates'
#    private keys can be derived from their public certificates. The base is a
#    pinned Airflow tag built long before that, so its bundle still trusts the
#    revoked roots and no rebuild of ours would drop them on its own. This
#    container IS a TLS client (the DAGs fetch from outside), so unlike the
#    third-party server images the check also flags, here the bundle is used.
#    See scripts/ca-distrust-ci-collect.sh.
RUN apt-get update \
 && apt-get install -y --no-install-recommends docker.io \
 && apt-get install -y --only-upgrade libbrotli1 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
USER airflow

# Providers/libraries used by the DAGs (amazon -> EMR symbols our overlay swaps;
# slack -> notifications; oauth2 -> jwt_auth.py).
RUN pip install --no-cache-dir \
      "apache-airflow-providers-amazon==8.23.0" \
      "apache-airflow-providers-slack" \
      "requests_oauth2client==1.1.0" \
      "boto3>=1.34" \
      "certifi>=2026.10.23"
# certifi, not pinned to one release: requests and boto3 verify TLS against certifi's
# own bundle, NOT /etc/ssl/certs, so upgrading the system ca-certificates above does
# nothing for the DAGs' outbound calls. The base ships certifi 2024.08.30, which still
# carries both eMudhra roots (measured). >= 2026.10.23 is the first release after the
# distrust that drops them; a floor rather than a pin, because a frozen CA bundle is
# the problem this is fixing.
# requests_oauth2client pinned to match pipelines-airflow/dags/requirements.txt (==1.1.0):
# export_event_core_dag.py imports `BearerAuth`, which newer releases removed/renamed.
