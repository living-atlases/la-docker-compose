{{ ansible_managed | comment }}
[Unit]
Description=Daily reclaim of unreferenced Docker/containerd image layers

[Timer]
OnCalendar={{ docker_housekeeping_gc_oncalendar }}
# A host that was down at 02:00 still gets its GC on the next boot — the disk
# does not care that the timer was missed.
Persistent=true
RandomizedDelaySec=900

[Install]
WantedBy=timers.target
