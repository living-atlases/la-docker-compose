{{ ansible_managed | comment }}
[Unit]
Description=Weekly CVE scan of the running Docker images (report by mail, never published)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/trivy-scan.sh
# Housekeeping must never compete with the stack for CPU or IO.
Nice=19
IOSchedulingClass=idle
