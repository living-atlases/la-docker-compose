# Included from the data-quality vhost — GENERATED, do not edit by hand.
# The hub asks for these filters three times per page, without caching them, and they
# barely change. Served stale while data-quality restarts.
proxy_cache data_quality;
proxy_cache_key $request_uri;
proxy_cache_valid 200 5m;
proxy_cache_lock on;
proxy_cache_background_update on;
proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
proxy_ignore_headers Vary Cache-Control Expires Set-Cookie;
