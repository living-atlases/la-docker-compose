# ecodata - data services backend for BioCollect (MongoDB + Elasticsearch, Grails exec jar).
# Its config comes from the ala-install ecodata role (see generate-compose.yml).
services:
  ecodata:
    image: {% set svc_reg = ecodata_registry | default(docker_registry | default('')) %}{{ svc_reg }}{% if svc_reg %}/{% endif %}ecodata:{{ ecodata_version | default('latest') }}
    container_name: {{ ecodata_docker_host | default('la_ecodata') }}
    profiles: [app-core, full]
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    restart: unless-stopped
    expose:
      - {{ ecodata_port | default('8080') }}
    environment:
      TZ: {{ server_tz | default('UTC') }}
      JAVA_OPTS: ${ECODATA_JAVA_OPTS}
    volumes:
      # config, uploads, models and scripts: the role writes them under /data/ecodata.
      - {{ data_dir }}/ecodata:/data/ecodata
      # java.io.tmpdir and logback.xml point outside /data/ecodata; neither exists in the image.
      - {{ data_dir }}/ecodata/tmp:/data/tmp
      - {{ data_dir }}/ecodata/logs:/var/log/atlas/ecodata
    networks:
      default: {}
      {{ docker_network | default('internal') }}:
    # MongoDB and the ES sidecar are boot dependencies. ClamAV (clamav_host, on-demand upload
    # scanning) is a runtime dep that converges by retry, so it is not a boot gate.
    depends_on:
      ecodata-elasticsearch:
        condition: service_healthy
{% if datastore_endpoints.get('mongodb', {}).get('colocated', false) %}
      mongodb:
        condition: service_healthy
{% endif %}
    healthcheck:
      # ecodata has no health route and ships actuator disabled: any HTTP answer proves it is up.
      test: ["CMD", "sh", "-c", "curl --silent --output /dev/null http://localhost:{{ ecodata_port | default('8080') }}/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 240s
