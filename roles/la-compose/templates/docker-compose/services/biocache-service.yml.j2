# Biocache Service - Records web service
services:
  biocache-service:
    image: {% set svc_reg = biocache_service_registry | default(docker_registry | default('')) %}{{ svc_reg }}{% if svc_reg %}/{% endif %}biocache-service:{{ biocache_service_version | default('latest') }}
    container_name: la_biocache-service
    profiles: [app-core, full]
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
{# depends_on can only reference services in THIS host's compose file. cassandra/
   solr may run on another host (VM model); when remote we omit the dependency and
   let restart: unless-stopped + app retry converge (swarm converge-by-retry). #}
{% set _i18n_dep = (i18n.enabled and i18n.strategy == 'volume' and i18n.volume.source == 'init-container') %}
{% set _cassandra_local = datastore_endpoints.get('cassandra', {}).get('colocated', false) %}
{% set _solr_local = datastore_endpoints.get('solr', {}).get('colocated', false) %}
    depends_on:
      # The index field list is read once, on `main`, at boot, and cached for the life of
      # the process. Boot before the Solr collection exists and /index/fields answers `[]`
      # until someone restarts the container — with HTTP 200, so nothing notices. Solr is
      # usually on another host, so this gate is an HTTP poll rather than a depends_on;
      # see infrastructure/wait-for-solr-collection.yml.
      wait-for-solr-collection:
        condition: service_completed_successfully
{% if _i18n_dep %}
      i18n-init:
        condition: service_completed_successfully
{% endif %}
{% if _cassandra_local %}
      cassandra:
        condition: service_healthy
      cassandra-load-keyspace:
        condition: service_completed_successfully
{% endif %}
{% if _solr_local %}
      solr:
        condition: service_healthy
{% endif %}
    volumes:
      # Host /data/biocache is mounted at TWO container paths because the
      # image's hardcoded -Dlogging.config expects /data/biocache-service/,
      # while the bundled application.properties imports config from
      # /data/biocache/config/biocache-config.properties (Spring ConfigData).
      # Without /data/biocache, cassandra.hosts silently defaults to localhost.
      - {{ data_dir }}/biocache:/data/biocache
      - {{ data_dir }}/biocache:/data/biocache-service
      # Offline downloads need TWO more host dirs, both already created (owner uid 1000, the
      # container's user) by ala-install's biocache3-service "ensure target directories exist":
      #   /data/cache/downloads  -> JsonPersistentQueueDAOImpl's `download.cache.dir`, where the
      #                             queued download's offline<ts>.json is persisted. Without it
      #                             EVERY offline download dies with 500 "(No such file or
      #                             directory)" AFTER passing auth — which reads like an auth bug.
      #   /data/biocache-download -> `download.dir`, where the produced ZIP lands (and which
      #                             nginx serves as /biocache-download; see nginx.yml.j2).
      # Container-only: on VMs the app runs on the host and already sees these paths.
      # /data/cache is the container-side default (download.cache.dir is not emitted by the
      # biocache3-properties template), so the host dir maps onto that fixed path. download.dir
      # IS emitted from `download_dir`, so mount it at whatever path the config names.
      - {{ data_dir }}/cache:/data/cache
      - {{ download_dir | default(data_dir ~ '/biocache-download') }}:{{ download_dir | default(data_dir ~ '/biocache-download') }}
{% include '_i18n_volumes.yml.j2' %}
    restart: unless-stopped
    expose:
      - 8080
    environment:
      TZ: {{ server_tz | default('UTC') }}
      JAVA_OPTS: ${BIOCACHE_SERVICE_JAVA_OPTS}
    networks:
      default: {}
      {{ docker_network | default('internal') }}:
    healthcheck:
      # /actuator/health da 503 (DOWN, diagnóstico aparte). /index/fields es ligero y prueba
      # liveness, pero OJO: NO prueba que el índice se haya leído. Devuelve 200 con `[]`
      # cuando la colección no existía al arrancar (verificado el 2026-08-07 sobre el #345),
      # así que este check estaba verde sobre un endpoint vacío. Quien garantiza el
      # contenido es la puerta wait-for-solr-collection, no este healthcheck; endurecerlo a
      # "array no vacío" acoplaría la salud del servicio a que haya índice, y con el
      # presupuesto de converge tan justo eso se paga en reinicios.
      test: ["CMD", "sh", "-c", "curl --fail --silent http://localhost:8080/index/fields || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
