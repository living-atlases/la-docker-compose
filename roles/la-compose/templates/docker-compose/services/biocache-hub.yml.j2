# Biocache Hub - Records search frontend
{# Rendered once per data hub instance (tasks/generate-hub-instance.yml). The portal
   is instance #0 with an empty suffix, so the default below reproduces the pre-hub
   file byte for byte. Rule of the whole feature: the hub identity lives in HOST
   paths; the paths inside the container never carry it, because the stock image
   reads fixed ones. #}
{% set inst = inst | default({'pkg': '', 'suffix': '', 'is_portal': true,
                              'biocache_hub': biocache_hub | default('ala-hub'),
                              'use_branding': true, 'has_branding': true}) %}
{# A hub without a branding of its own reuses the portal's, so it waits on the
   portal's gate rather than on one that is never generated for it. #}
{% set brand_gate = 'wait-for-branding' ~ (inst.suffix if inst.has_branding | default(true) else '') %}
{# Same gate as collectory: only depend on i18n-init when the volume is actually
   populated by that init container. #}
{% set _i18n_dep = (i18n.enabled and i18n.strategy == 'volume' and i18n.volume.source == 'init-container') %}
services:
  biocache-hub{{ inst.suffix }}:
    image: {% set svc_reg = biocache_hub_registry | default(docker_registry | default('')) %}{{ svc_reg }}{% if svc_reg %}/{% endif %}ala-hub:{{ biocache_hub_version | default('latest') }}
    container_name: la_biocache-hub{{ inst.suffix }}
    profiles: [app-core, full]
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    depends_on:
      # Order-independent: wait until branding actually serves before the hub boots and
      # caches the commonui header/footer (else g:applyLayout NPE -> 500). Same gate the
      # other hubs already use; see infrastructure/wait-for-branding.yml.
      {{ brand_gate }}:
        condition: service_completed_successfully
{% if _i18n_dep %}
      # /occurrences/search 500s right after a clean deploy:
      #   GrailsTagException: [views/occurrence/list.gsp:22] <alatag:message>
      #   Cannot invoke "java.util.Map.size()" because "<parameter1>" is null
      # alatag:message -> MessageSourceCacheService.getMessagesMap() ->
      # listMessageCodes() -> getMergedProperties(locale), which putAll()s a null
      # Properties. Waiting for i18n-init is right for the LOCAL half of that merge (the
      # hub mounts the volume below and, unlike collectory/cas/species-list, used to boot
      # without waiting for it), so the gate stays.
      #
      # It is NOT sufficient, and the earlier note here - "it heals itself hours later once
      # cacheMillis expires" - is wrong; build #356 disproved it. There /opt/atlas/i18n was
      # populated at 21:12:25, the hub booted at 21:13:29 with the gate satisfied, and the
      # NPE still fired on every request from 21:40 onwards, never healing in the 2.5 h
      # until the hub was restarted by hand.
      #
      # What clears it is restarting THE HUB; that much is established. The mechanism is
      # not. Two things were ruled out on #356, so do not spend time on them again:
      #   - the i18n volume (populated before the hub booted, gate satisfied);
      #   - biocache-service's empty field list. It looks compelling, because
      #     ExtendedPluginAwareResourceBundleMessageSource and
      #     MessageSourceCacheService.clearMessageCache both talk about fetching base
      #     properties over HTTP from biocache-service - but that bean is commented out in
      #     the plugin's resources.groovy, ala-hub defines none, and nginx logged 0 requests
      #     to /facets/i18n against 30 to /index/fields in the same window. The hub does not
      #     make that call.
      # Upstream is unchanged since 2021, so ala-hub 8.3.0 carries the same code as 8.1.0:
      # an upgrade is not the fix either. Tracked separately from the biocache-service bug.
      #
      # scripts/refresh-biocache-fields.sh restarts the hub after an ingest, which is where
      # this has been observed; it is a known-good remedy, not a mechanism.
      i18n-init:
        condition: service_completed_successfully
{% endif %}
    volumes:
      - {{ data_dir }}/{{ inst.biocache_hub }}:/data/ala-hub
{% if inst.suffix %}
      # ala-install writes the properties under the hub's own name; the stock war only
      # reads ala-hub-config.properties. Docker renames it at the mount, which is exactly
      # what the VM hubs need a hand-made symlink for.
      - {{ data_dir }}/{{ inst.biocache_hub }}/config/{{ inst.biocache_hub }}-config.properties:/data/ala-hub/config/ala-hub-config.properties:ro
      # logback.xml (ala-install) hardcodes LOG_DIR=/{{ data_dir }}/{{ inst.biocache_hub }}/logs,
      # a HOST-shaped path that does not exist behind the /data/ala-hub mount above.
      - {{ data_dir }}/{{ inst.biocache_hub }}:/data/{{ inst.biocache_hub }}
{% endif %}
{% include '_i18n_volumes.yml.j2' %}
    restart: unless-stopped
    expose:
      - 8080
{% if ('biocache-hub:' ~ inst.pkg) in (nginx_shared_ports_needed | default([])) %}
    # This front-end is a local member of a hostname ALSO claimed by a sibling
    # on another physical host (hub.l-a.site-style path split, see
    # generate-compose.yml's "Resolve cross-host shared-vhost membership").
    # Publish on the private IP so that sibling's stub proxy (see
    # register-shared-vhost-stubs.yml) can reach this container directly,
    # without going through this host's nginx.
    ports:
      - "{{ host_private_ip }}:18180:8080"
{% endif %}
    environment:
      TZ: {{ server_tz | default('UTC') }}
      # ala-install writes server.contextPath (Grails 3 key) into the hub config, which
      # Spring Boot 2 images ignore; nginx (and the shared-vhost stubs) proxy the full
      # path, so a hub mounted under a path (e.g. hub.l-a.site/records) must serve there.
      JAVA_OPTS: ${BIOCACHE_HUB_JAVA_OPTS}{{ (' -Dserver.servlet.context-path=' ~ biocache_hub_context_path) if (biocache_hub_context_path | default('')) not in ['', '/'] else '' }}
      # Bundled application.yml references ${security.jwt.enabled} via SpEL,
      # but the upstream ala-hub-config.properties template never declares it.
      # Spring relaxed binding maps this env to the missing property.
      SECURITY_JWT_ENABLED: "{{ security_jwt_enabled | default('false') }}"
    networks:
      default: {}
      {{ docker_network | default('internal') }}:
    healthcheck:
      test: ["CMD", "sh", "-c", "curl --fail --silent http://localhost:8080{{ biocache_hub_context_path | default('') | regex_replace('/+$', '') }}/actuator/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      # 180s (subido de 60s tras #249, consistencia con bie-hub): hub Grails de arranque
      # lento; en cold-boot con volúmenes frescos evita el `unhealthy` prematuro y el
      # converge-restart contraproducente. Sondea /actuator/health (no depende de branding).
      start_period: 180s
