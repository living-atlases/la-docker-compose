services:
   sensitive-data-service:
     container_name: la_sensitive_data_service
     profiles: [app-core, full]
     # LEGACY image: atlasoflivingaustralia/ala-sensitive-data-service, built against the older
     # Lucene major the inventory points this service at
     # (ala_sensitive_data_service_namematching_source). The nextgen
     # livingatlases/ala-sensitive-data-server:latest crash-loops on that index (it needs a
     # newer/atlas-index one). Override sensitive_data_image to use a different build.
     image: {{ sensitive_data_image | default('atlasoflivingaustralia/ala-sensitive-data-service:1.1.1-20210811-3') }}
     ports:
       - "{{ sensitive_data_service_port }}:9189"
       - "{{ sensitive_data_admin_port }}:9190"
     environment:
       - JAVA_OPTS=-Xmx2g -Xms1g
       - SENSITIVE_DATA_SERVICE_JAVA_OPTS=-Xmx2g -Xms1g
     volumes:
       # Its own index, NOT namematching-service's .../namematching-nm (different Lucene major).
       # Same path inside and outside: config.yml renders conservation.index with this suffix.
       - "{{ data_dir }}/lucene/namematching-{{ sds_nameindex_datestamp }}:/data/lucene/namematching-{{ sds_nameindex_datestamp }}:ro"
       - "{{ data_dir }}/sds:/data/sds:ro"
       - "{{ data_dir }}/biocache/layers:/data/biocache/layers:ro"
       # El contenedor lee la config en .../ala-sensitive-data-service/config (la app dropwizard
       # falla con FileNotFoundException si se monta en .../ala-sensitive-data-server/config).
       # La imagen se llama -server pero el path de config que espera es -service.
       - "{{ data_dir }}/ala-sensitive-data-service/config:/data/ala-sensitive-data-service/config:ro"
     networks:
       default: {}
       {{ docker_network | default('internal') }}:
     healthcheck:
       test: ["CMD", "curl", "--fail", "--silent", "http://localhost:9190/healthcheck"]
       interval: 30s
       timeout: 10s
       retries: 3
       start_period: 60s
     restart: unless-stopped
