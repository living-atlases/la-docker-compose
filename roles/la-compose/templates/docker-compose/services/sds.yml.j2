# SDS - Sensitive Data Service (legacy sds-webapp2).
#
# ALA migrated to the nextgen ala-sensitive-data-server (group `sensitive-data-service`); the
# community stack keeps the maintained legacy service via the livingatlases/sds-webapp2 image
# (Spring Boot executable WAR, JDK 11, served at the context root). No datastore dependency: it
# reads a bundled lucene index + sensitivity XMLs and calls out to layers-service / species-lists.
services:
  sds:
    image: {% set svc_reg = sds_registry | default(docker_registry | default('')) %}{{ svc_reg }}{% if svc_reg %}/{% endif %}sds-webapp2:{{ sds_version | default('1.7.1') }}
    container_name: {{ sds_docker_host | default('la_sds') }}
    profiles: [app-core, full]
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    restart: unless-stopped
    expose:
      - {{ sds_port | default('8080') }}
    environment:
      TZ: {{ server_tz | default('UTC') }}
      JAVA_OPTS: ${SDS_JAVA_OPTS}
    volumes:
      # The sds role writes config + sensitivity XMLs under {{ data_dir }}/sds. The image expects
      # its spring config at /data/sds-webapp2/config; the app also reads /data/sds/config
      # (ala.admin.systemMessage.path), so expose the role dir under both paths.
      - {{ data_dir }}/sds/config:/data/sds-webapp2/config
      - {{ data_dir }}/sds:/data/sds
      # logback.xml writes to /var/log/tomcat9; the image has no writable /var/log/tomcat9 (uid
      # 1000), so bind a host dir (created uid 1000 by config-dir-ensure), mirroring doi-service.
      - {{ data_dir }}/sds/logs:/var/log/tomcat9
      # Its Lucene 8 name index (sds_webapp_nameindex_*, unpacked by sds-webapp-nameindex.yml):
      # sds-config.properties reads namematching-index=/data/lucene/namematching.
      - {{ sds_webapp_nameindex_dir }}:/data/lucene/namematching:ro
    networks:
      default: {}
      {{ docker_network | default('internal') }}:
    healthcheck:
      # A name lookup, not /: without a name index it can read, the app serves / and answers
      # every /ws/<name> with 200 and "The SDS finder has not been initialised" (TASK-95), which
      # is unhealthy. The finder loads in the background after boot, hence start_period.
      # A 500 is NOT unhealthy here: with no SDS list in species-lists (a portal without data,
      # like the CI) the finder is never built and every lookup 500s, which is a data state, not
      # a broken container.
      test: ["CMD-SHELL", "curl -sS -m 20 -o /tmp/sds-healthcheck 'http://localhost:{{ sds_port | default('8080') }}/ws/{{ sds_webapp_probe_name | default('Acacia dealbata') | urlencode }}' && ! grep -q 'has not been initialised' /tmp/sds-healthcheck"]
      interval: 30s
      timeout: 25s
      retries: 5
      start_period: 300s
