services:
  la_pipelines:
    image: {% set svc_reg = la_pipelines_registry | default(docker_registry | default('')) %}{{ svc_reg }}{% if svc_reg %}/{% endif %}la-pipelines:${TAG:-latest}
    container_name: la_pipelines
    profiles: [app-core, full]
    # Cross-host datastore reachability: on multihost the pipelines host (e.g. mh-3)
    # must reach solr/zookeeper/cassandra on other hosts. Every other cross-host
    # consumer renders this (see biocache-service.yml.j2); pipelines was missing it,
    # so la_pipelines had an empty ExtraHosts and the solr/index stages could not
    # resolve solr:8983 / zookeeper:2181. Single-host: dict is empty -> no-op.
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    user: "1000:1000"
    # Cap container memory to avoid the Exit 137 OOM-kill. Must be >= the per-stage JVM
    # heap (pipelines_jvm_def_options, e.g. -Xmx3g) plus ~1g overhead. Tune via env.
    mem_limit: ${PIPELINES_MEM_LIMIT:-4g}
    environment:
      - TZ=${TZ:-Europe/Brussels}
      - JAVA_OPTS=${PIPELINES_JAVA_OPTS:-}
      - EXTRA_JVM_CLI_ARGS=${EXTRA_JVM_CLI_ARGS:-}
    volumes:
      - ${DATA_DIR:-/data}/la-pipelines:/data/la-pipelines
      - ${DATA_DIR:-/data}/la-pipelines/data:/data/la-pipelines/data
      - ${DATA_DIR:-/data}/la-pipelines/vocabularies:/data/la-pipelines/vocabularies
      - ${DATA_DIR:-/data}/la-pipelines/spark-tmp:/data/la-pipelines/spark-tmp
      - ${DATA_DIR:-/data}/la-pipelines/dwca-import:/data/la-pipelines/dwca-import
      - ${DATA_DIR:-/data}/logs/pipelines:/app/livingatlas/pipelines/target/logs
      - ${DATA_DIR:-/data}/pipelines-shp:/data/pipelines-shp
      - ${DATA_DIR:-/data}/dwca-tmp:/data/dwca-tmp
      - ${DATA_DIR:-/data}/dwca-export:/data/dwca-export
      # Cross-dataset working paths. la-pipelines-local.yaml renders these as bare
      # root-level paths ({{ '{{ fs }}' }}/pipelines-all-datasets etc.) because upstream they are
      # HDFS paths; ala-install only mkdirs them via `hdfs dfs -mkdir` and skips that
      # entirely when deployment_type == 'container'. Nothing then creates them, so
      # `la-pipelines solr` died with "No files matched spec:
      # /pipelines-all-datasets/index-record/<dr>/*.avro". Bind them into the data
      # volume so the paths exist, persist, and stay inside DATA_DIR.
      - ${DATA_DIR:-/data}/la-pipelines/all-datasets:/pipelines-all-datasets
      - ${DATA_DIR:-/data}/la-pipelines/species:/pipelines-species
      - ${DATA_DIR:-/data}/la-pipelines/jackknife:/pipelines-jackknife
      - ${DATA_DIR:-/data}/la-pipelines/clustering:/pipelines-clustering
      - ${DATA_DIR:-/data}/la-pipelines/outlier:/pipelines-outlier
{% if use_airflow | default(false) | bool %}
      # The pipelines-airflow DAGs invoke helper scripts and CLIs by absolute /tmp path
      # (/tmp/create_solr_collection_cli.py, /tmp/download-datasets-for-indexing.sh, ...).
      # On EMR the cluster's BootstrapActions copy them there from S3; our local shim has
      # no cluster to bootstrap, so nothing ever lands in /tmp and every such step dies
      # with "No such file". Those files are just part of the dags/ tree, which Ansible
      # already stages on this host, so mount it and let the overlay's translator repoint
      # the reference. Same path in la_airflow, so a step's command is valid in whichever
      # container it is routed to.
      - {{ docker_compose_data_dir }}/pipelines-airflow/dags:/opt/pa-dags:ro
{% endif %}
    networks:
      - ${DOCKER_NETWORK:-internal}
    # LA Pipelines is a stateful service, healthcheck verifies data dirs exist
    healthcheck:
      test: ["CMD", "test", "-d", "/data/la-pipelines/data"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 60s
    stdin_open: true
    tty: true
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
