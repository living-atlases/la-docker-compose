  # Elasticsearch - Search and analytics engine
services:
  elasticsearch:
    # 8.10.0 is on Ubuntu focal, which has no fixed libbrotli1 (CVE-2026-111497). 8.17 is on noble;
    # the derived image adds the distro's libbrotli1 update. Minor upgrade of 8.x: a data volume
    # written by 8.10 opens as it is. elasticsearch_image takes the whole reference.
    image: {{ elasticsearch_image | default('livingatlases/elasticsearch:8.17.10-brotli') }}
    container_name: la_elasticsearch
    profiles: [dbs, full]
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    restart: unless-stopped
    expose:
      - 9200
      - 9300
    environment:
      TZ: {{ server_tz | default('UTC') }}
      discovery.type: "single-node"
      xpack.security.enabled: "false"
      ES_JAVA_OPTS: "-Xms512m -Xmx2g"
      indices.memory.index_buffer_size: "30%"
    volumes:
      - la_elasticsearch-data:/usr/share/elasticsearch/data
    networks:
      default: {}
      {{ docker_network | default('internal') }}:
        aliases:
          - elasticsearch
    healthcheck:
      test: ["CMD", "curl", "--fail", "--silent", "http://localhost:9200/_cluster/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
