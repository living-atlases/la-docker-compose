# Database Backup Service (MongoDB, MySQL, PostgreSQL)
services:
  db-backup:
    container_name: la_db-backup
    # tiredofit/db-backup is retired. On 2026-09-09 its `latest` tag was replaced by a
    # single static binary that prints "this image has moved" and nothing else: no shell,
    # no backup, no way for ANY healthcheck to pass. Builds #386+ burned the whole
    # converge budget on the two hosts carrying it. Successor, same DBxx_ env contract:
    # nfrastack/db-backup (5.0.7 parses the variables below; 5.0.2 lacked two, noted further on).
    # PINNED on purpose -- `latest` is what let an upstream retirement redden CI.
    image: nfrastack/db-backup:{{ db_backup_version | default('5.0.7') }}
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    volumes:
      - ../db-backups:/backup
    networks:
      default: {}
      {{ docker_network | default('internal') }}:
        aliases:
          - db-backup
    environment:
      - TIMEZONE={{ server_tz | default('UTC') }}
      - CONTAINER_NAME=db-backup
      - CONTAINER_ENABLE_MONITORING=FALSE
      # DB01_RESOURCE_OPTIMIZED was dropped: 5.x warns [DEPRECATED] and ignores it.
      # 5.0.2 reads neither DEFAULT_CLEANUP_TIME nor DEFAULT_BACKUP_BEGIN (5.0.7 reads both):
      # the jobs started at container start, and with no retention nothing was ever deleted.
      # So the cleanup time goes on each job, which 5.0.2 and 5.0.7 honour. It is minutes.
      # A job prunes all of /backup, not just its own dumps, and only after it succeeds: the
      # last dumps of a database that keeps failing go once another job outlives them.
      # DBnn_SPLIT_DB: one file per server, as scripts/restore-db-backup.sh expects. 5.0.2
      # writes that by default, 5.0.7 one file per database unless told otherwise.
      - BACKUP_JOB_CONCURRENCY=1
      - DEFAULT_CHECKSUM=NONE
      - DEFAULT_COMPRESSION=ZSTD
      - DEFAULT_BACKUP_INTERVAL={{ db_backup_interval | default('1440') }}
      - DEFAULT_BACKUP_BEGIN={{ db_backup_begin | default('0000') }}
      # MongoDB backup (DB01)
      # ALL, not one database. CAS spreads itself over several: the ticket registry, the
      # service registry, the spring sessions and the audit trail. A job named `admin` dumped
      # the users of the server and none of that, so a portal with CAS on docker-compose had
      # no copy of the only one that cannot be rebuilt, the audit trail.
      # `admin` was also doubling as the authSource, which DB01_AUTH now carries on its own.
      # The spelling the image reads is DBnn_NAME_EXCLUDE; DBnn_EXCLUDE is accepted and
      # ignored, which is why this one is explicit. `local` is the oplog and `config` the
      # sharding metadata: both belong to the server, not to the portal, and restore nowhere.
      # DB01_SPLIT_DB=TRUE, the opposite of DB02/DB03, because a mongo dump here is not a
      # mongodump archive: 5.0.7 writes a mongosh script of insertMany statements that names each
      # database in a comment only. One file holding several databases restores every one of them
      # into whichever database the shell happens to point at, so one file per database is the
      # only restorable shape. Restore with `mongosh <db> --file <dump>` once decompressed. The
      # script carries documents and their _ids, not index definitions: CAS rebuilds its own
      # (including the TTL ones) when it starts.
      - DB01_TYPE=mongo
      - DB01_HOST={{ mongodb_docker_host_address | default('mongodb') }}
      - DB01_NAME={{ mongo_backup_db | default('ALL') }}
      - DB01_AUTH={{ mongo_backup_auth_db | default('admin') }}
      - DB01_NAME_EXCLUDE={{ mongo_backup_db_exclude | default('local,config') }}
      - DB01_USER={{ mongodb_root_username }}
      - DB01_PASS=${MONGODB_ROOT_PASSWORD}
      - DB01_CLEANUP_TIME={{ db_cleanup_time | default('8640') }}
      - DB01_SPLIT_DB=TRUE
      # MySQL backup (DB02)
      - DB02_TYPE=mysql
      - DB02_HOST={{ collectory_db_host_address }}
      - DB02_NAME=all
      - DB02_USER=root
      - DB02_PASS=${MYSQL_ROOT_PASSWORD}
      - DB02_CLEANUP_TIME={{ db_cleanup_time | default('8640') }}
      - DB02_SPLIT_DB=FALSE
      # PostgreSQL backup (DB03)
      - DB03_TYPE=postgres
      - DB03_HOST={{ postgres_db_host_address | default('postgres') }}
      - DB03_NAME=all
      - DB03_USER={{ postgres_user | default('postgres') }}
      - DB03_PASS=${POSTGRES_PASSWORD}
      - DB03_CLEANUP_TIME={{ db_cleanup_time | default('8640') }}
      - DB03_SPLIT_DB=FALSE
    healthcheck:
      # The image's own healthcheck. It must be a binary the image actually ships: this
      # is a distroless image with no shell and no coreutils, so the previous
      # `["CMD", "test", "-d", "/backup"]` could not even be exec'd
      # (`exec: "test": executable file not found in $PATH`) and the container was
      # unhealthy forever, which the health gate correctly refuses to converge past.
      test: ["CMD", "/app/dbb", "version"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 60s
    restart: unless-stopped
