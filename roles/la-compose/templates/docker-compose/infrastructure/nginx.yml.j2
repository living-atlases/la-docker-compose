{# ---- Site-provided certificates (use_la_site_certs=false) --------------------------------
   The certs live on the DOCKER HOST, not on the Ansible controller. This template used to bind
   the role's inventory_dir + /certs/, a controller-side path that does not exist on a remote
   docker host: Docker then created it EMPTY and mounted it over the cert dir, so cert-validator found
   no certificate and exited non-zero, and nginx (depends_on: service_completed_successfully)
   never started. Mount the host's own tree at the identical path instead -- the same files
   nginx reads when it runs on a VM.
   Let's Encrypt's `live/<domain>/*.pem` are symlinks into `../../archive/<domain>/`, so mounting
   only the leaf directory would leave dangling links inside the container; mount /etc/letsencrypt
   whole in that case. Set ssl_certs_host_mount_dir to override for other layouts. #}
{% set ssl_certs_host_mount = ssl_certs_host_mount_dir | default('', true)
     or ('/etc/letsencrypt' if ssl_certificate_server_dir is match('^/etc/letsencrypt(/.*)?$')
         else ssl_certificate_server_dir) %}
services:
  # Certificate initialization service (only if using Docker image certs) to allow demo sites using SSL from test
  # domain l-a.site
  # if not using this, your own certs are mounted from the docker host at <ssl_certificate_server_dir>
{% if use_la_site_certs %}
{# Volume la-site-certs is mounted at /etc/letsencrypt/live for nginx/cert-validator; paths must match ssl_certificate_server_dir. #}
{% if ssl_certificate_server_dir is match('^/etc/letsencrypt/live(/.*)?$') %}
{% set la_site_certs_rel = ssl_certificate_server_dir | regex_replace('^/etc/letsencrypt/live/?', '') %}
{% else %}
{% set la_site_certs_rel = '' %}
{% endif %}
{% if la_site_certs_rel | length > 0 %}
{% set la_site_certs_out = '/out/' ~ la_site_certs_rel %}
{% else %}
{% set la_site_certs_out = '/out' %}
{% endif %}
  certs-init:
    image: livingatlases/l-a-site-certs:latest
    pull_policy: always
    container_name: la_certs-init
    profiles: [infra, core-auth, app-core, full]
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    entrypoint: /bin/sh
    command: -c 'set -e && echo "[*] Checking source certificates in image..." && ls -lah /certs/ && test -f /certs/fullchain.pem && test -s /certs/fullchain.pem && test -f /certs/privkey.pem && test -s /certs/privkey.pem && echo "[OK] Source certificates validated" && echo "[*] Extracting certificates to volume (writing to {{ la_site_certs_out }})..." && mkdir -p "{{ la_site_certs_out }}" && cat /certs/fullchain.pem > "{{ la_site_certs_out }}/fullchain.pem" && cat /certs/privkey.pem > "{{ la_site_certs_out }}/privkey.pem" && (cat /certs/chain.pem > "{{ la_site_certs_out }}/chain.pem" 2>/dev/null || true) && chmod 644 {{ la_site_certs_out }}/*.pem && echo "[*] Extracted certificates:" && ls -lahR /out/ && test -s "{{ la_site_certs_out }}/fullchain.pem" && test -s "{{ la_site_certs_out }}/privkey.pem" && echo "[SUCCESS] Certificates extracted successfully"'
    volumes:
      - la-site-certs:/out
    networks:
      default: {}
      {{ docker_network | default('internal') }}:
{% endif %}

  # Certificate validator service - validates SSL certificates before nginx starts
  # Checks: file existence, PEM format, expiration, and cert/key match
  # before nginx starts to avoid runtime SSL errors
  cert-validator:
    image: alpine/openssl:latest
    container_name: la_cert-validator
    profiles: [infra, core-auth, app-core, full]
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    entrypoint: /bin/sh
    command: /scripts/cert-validator.sh
    volumes:
{% if use_la_site_certs %}
      - la-site-certs:/etc/letsencrypt/live:ro
{% else %}
      - "{{ ssl_certs_host_mount }}:{{ ssl_certs_host_mount }}:ro"
{% endif %}
      - ../cert-validator:/scripts:ro
    environment:
      SSL_CERT_DIR: "{{ ssl_certificate_server_dir }}"
      SSL_CERT_FILE: "{{ ssl_cert_file }}"
      SSL_KEY_FILE: "{{ ssl_key_file }}"
    networks:
      default: {}
      {{ docker_network | default('internal') }}:
{% if use_la_site_certs %}
    depends_on:
      certs-init:
        condition: service_completed_successfully
{% endif %}
    restart: "no"

  # Nginx reverse proxy
  nginx:
    container_name: la_nginx
    profiles: [infra, core-auth, app-core, full]
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    image: nginx:{{ docker_nginx_version | default('1.25') }}
    ports:
      - "80:80"
      - "443:443"
{% if docker_metrics_enabled | default(true) %}
{# Disk metric for Gatus, bound to this host's PRIVATE address — never 0.0.0.0.
   `expose:` alone would be tighter, but gatus runs on exactly one host of the
   cluster and an exposed port is reachable only inside that host's own compose
   network, which leaves every other host unmonitored. On gbif-es-docker-prod-2026
   that means -1 watched and -2/-3 blind — and -3 is one of the two that filled up
   on 2026-08-04. The server block behind this port serves /disk.json and 404s
   everything else (conf.d/metrics.conf). Override docker_metrics_bind when the
   inventory's ansible_host is not the interface gatus should reach.
   NOTE: additional list item under the SAME ports: key — a second `ports:` mapping
   key is invalid YAML (docker compose refuses to parse the file). #}
      - "{{ docker_metrics_bind | default(host_private_ip) }}:{{ docker_metrics_port | default(8081) }}:{{ docker_metrics_port | default(8081) }}"
{% endif %}
    volumes:
      - "{{ nginx_conf_dir }}/nginx.conf:/etc/nginx/nginx.conf:ro"
      - "{{ nginx_conf_dir }}/conf.d:/etc/nginx/conf.d:ro"
{% if docker_metrics_enabled | default(true) %}
      - "{{ nginx_conf_dir }}/metrics:/etc/nginx/metrics:ro"
{% endif %}
      - "{{ nginx_conf_dir }}/sites-enabled:/etc/nginx/sites-enabled:ro"
      - "{{ nginx_conf_dir }}/sites-available:/etc/nginx/sites-available:ro"
{# branding may run on THIS physical host via physical_server_groups even when the
   .docker_compose alias's group_names does not list 'branding' (multi-host scope, same
   class as the gatus/nginx-vars-scope bug). Use the same co-location check as the
   branding-init service and the branding vhost, or nginx mounts the EMPTY ../srv
   fallback instead of the populated la_branding-assets volume and serves 404 for every
   branding asset (ORB-blocked CSS/JS -> unstyled site). #}
{% set branding_colocated = ('branding' in group_names) or ('branding' in (physical_server_groups | default([]))) %}
{% if branding_colocated %}
      # Mount branding assets volume first (read-write for init container to populate)
      - la_branding-assets:/srv/{{ branding_url | default('branding') }}/www:ro
{% else %}
      # Mount srv directory only if no branding (branding uses volume instead)
      - ../srv:/srv:ro
{% endif %}
{# ---- Static `alias` locations declared by ala-install's nginx_vhost role ----------------
   Several roles register an `alias:` entry in `nginx_paths` (grep '^\s*alias:' over
   ala-install/ansible/roles/*/tasks/*.yml). nginx_vhost renders them verbatim as
   `alias <host path>;` inside that service's vhost. On a VM nginx runs on the host and reads
   those paths directly; in a container it sees NOTHING unless the directory is bind-mounted
   at the SAME path the alias names — otherwise every such location silently 404s, which
   reads as "the file was never produced" rather than "nginx cannot see it". That is how
   biocache's finished download ZIPs were lost.

   So: one map, kept in sync with ala-install, instead of a per-service patch each time
   somebody trips over it. Mounted read-only at the identical path, and only for services
   co-located with this nginx (same union-of-groups check the branding/vhost logic uses;
   a non-co-located entry would bind-mount a non-existent dir and Docker would create it
   root-owned). Only services that have a la-compose template are listed.

   KEYS ARE INVENTORY GROUP NAMES, which are not always the service name — biocache-service
   lives in the `biocache-service-clusterdb` group, and guessing `biocache-service` here
   silently rendered no mount at all (the map just never matched), so the ZIPs kept 404ing
   while everything upstream looked fine. Cross-check a new key against how
   generate-compose.yml refers to the service before adding it. Duplicate keys pointing at
   the same directory are harmless: the dedup below emits one mount. #}
{% set nginx_serving_groups = (group_names | union(physical_server_groups | default([]))) | reject('in', skip_services | default([])) | list %}
{% set nginx_alias_dirs = {
     'sensitive-data-service': [data_dir ~ '/sds'],
     'sds-static-home':        [data_dir ~ '/sds'],
     'biocache-service-clusterdb': [download_dir | default(data_dir ~ '/biocache-download')],
     'biocache-service':       [download_dir | default(data_dir ~ '/biocache-download')],
     'spatial-service':        [data_dir ~ '/ala/runtime/files'],
     'biocollect':             [biocollect_pwa_app_path | default('/data/biocollect/mobile-app')],
   } %}
{% set nginx_alias_mounted = [] %}
{% for alias_service, alias_dirs in nginx_alias_dirs | dictsort %}
{% if alias_service in nginx_serving_groups %}
{% for alias_dir in alias_dirs if alias_dir not in nginx_alias_mounted %}
{% set _ = nginx_alias_mounted.append(alias_dir) %}
      # {{ alias_service }}: static alias location in its vhost
      - "{{ alias_dir }}:{{ alias_dir }}:ro"
{% endfor %}
{% endif %}
{% endfor %}
{% if use_la_site_certs %}
      - la-site-certs:/etc/letsencrypt/live:ro
{% else %}
      - "{{ ssl_certs_host_mount }}:{{ ssl_certs_host_mount }}:ro"
{% endif %}
    depends_on:
{% if use_la_site_certs %}
      certs-init:
        condition: service_completed_successfully
{% endif %}
      cert-validator:
        condition: service_completed_successfully
{% if branding_colocated %}
      branding-init:
        condition: service_completed_successfully
{% endif %}
    networks:
      default: {}
      {{ docker_network | default('internal') }}:
{% if nginx_docker_internal_aliases %}
        aliases:
          # These aliases allow services to reach nginx on the internal network using vhost hostnames
          # Example: service can resolve auth-es.l-a.site to nginx container internally
{# sort: the list is accumulated with union/unique, which round-trips through a
   Python set, so its order changes between runs and rewrites this file on every
   regeneration. Docker resolves network aliases as a set, so ordering them is
   free and makes the generated artifact diffable. #}
{% for alias in nginx_docker_internal_aliases | sort %}
          - {{ alias }}
{% endfor %}
{% endif %}
    healthcheck:
      test: ["CMD", "nginx", "-t"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    restart: unless-stopped
    environment:
      TZ: {{ server_tz | default('UTC') }}

