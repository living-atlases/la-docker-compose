  # Cassandra - NoSQL database for biocache
services:
  cassandra:
    image: cassandra:{{ cassandra_version | default('5.0.6') }}
    container_name: la_cassandra
    profiles: [dbs, full]
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    restart: unless-stopped
    expose:
      - 7000
      - 7001
      - 7199
      - 9042
      - 9160
{% if publish_db_ports_clusterwide | default(false) | bool %}
    # Multi-host: publish the CQL port on the host private IP so remote consumers
    # (e.g. biocache-service on another host) can reach it via host:port + extra_hosts.
    # Operator must firewall this to the private cluster subnet.
    ports:
      - "{{ host_private_ip }}:9042:9042"
{% endif %}
    environment:
      TZ: {{ server_tz | default('UTC') }}
      CASSANDRA_CLUSTER_NAME: "{{ cassandra_cluster_name | default('ala-cluster') }}"
      CASSANDRA_DC: "datacenter1"
      CASSANDRA_RACK: "rack1"
{% if cassandra_seeds | default('cassandra') != '' %}
      CASSANDRA_SEEDS: "{{ cassandra_seeds | default('cassandra') }}"
{% endif %}
      CASSANDRA_START_RPC: "true"
      HEAP_NEWSIZE: "{{ cassandra_heap_newsize | default('256m') }}"
      MAX_HEAP_SIZE: "{{ cassandra_max_heap | default('2g') }}"
    volumes:
      - la_cassandra-data:/var/lib/cassandra
    networks:
      default: {}
      {{ docker_network | default('internal') }}:
        aliases:
          - cassandra
    healthcheck:
      test: ["CMD", "nodetool", "status"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 120s

  cassandra-load-keyspace:
    image: cassandra:{{ cassandra_version | default('5.0.6') }}
    container_name: la_cassandra_init
    profiles: [dbs, full]
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    restart: "no"
    command:
      - /bin/bash
      - -c
      - |
        echo "Waiting for Cassandra..."
        # Wait using cqlsh
        while ! cqlsh cassandra -e "describe keyspaces" > /dev/null 2>&1; do
            echo "Cassandra not ready yet..."
            sleep 5
        done
        echo "Cassandra is up! Loading schema..."
        cqlsh cassandra -f /docker-entrypoint-initdb.d/schema.cql
        echo "Schema loaded!"
    volumes:
      - {{ data_dir }}/cassandra/init:/docker-entrypoint-initdb.d:ro
    networks:
      {{ docker_network | default('internal') }}:
    depends_on:
      cassandra:
        condition: service_healthy

