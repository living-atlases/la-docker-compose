services:
  # Order-independent Solr collection readiness gate.
  #
  # biocache-service reads the index field list ONCE, on the `main` thread at boot, via
  # /admin/luke, and caches it for the life of the process. If the `biocache` collection
  # does not exist yet at that moment, the luke query fails and the cache is left EMPTY
  # for good:
  #
  #   ERROR au.org.ala.biocache.dao.SolrIndexDAOImpl (SolrIndexDAOImpl.java:386)
  #   query failed-1 - SOLRQuery: qt=/admin/luke&tr=luke.xsl&fl=&numTerms=1
  #                             : Collection not found: biocache
  #
  # From then on /index/fields answers `[]` — with HTTP 200, which is why the healthcheck
  # and the old gatus check both stayed green over a broken endpoint for months. Verified
  # on 2026-08-07 against build #345: `[]` before, 83 fields after nothing but a restart.
  #
  # Same shape as wait-for-branding, and cross-host safe for the same reason: it polls the
  # collections API over HTTP through the `solr` alias (datastore_cluster_spec aliases +
  # extra_hosts), so it works wherever Solr is deployed. Use `solr`, NOT `la_solr`: the
  # underscore makes the name URI-invalid for the Java client (see solr.yml.j2). It always
  # exits 0, after success or a generous timeout, so it can never deadlock the converge.
  wait-for-solr-collection:
    container_name: la_wait-for-solr-collection
    profiles: [app-core, full]
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    image: curlimages/curl:8.11.1
    networks:
      default: {}
      {{ docker_network | default('internal') }}: {}
    environment:
      TZ: {{ server_tz | default('UTC') }}
      SOLR_BASE: "http://solr:{{ datastore_endpoints.get('solr', {}).get('port', 8983) }}"
      SOLR_COLLECTION: "{{ solr_collection | default('biocache') }}"
    entrypoint: ["sh", "-c"]
    command:
      - |
        url="$${SOLR_BASE}/solr/admin/collections?action=LIST&wt=json"
        echo "wait-for-solr-collection: polling $$url for '$${SOLR_COLLECTION}'"
        n=0
        while true; do
          # Match the quoted name so `biocache` cannot be satisfied by `biocache-something`.
          if curl -sk --max-time 5 "$$url" 2>/dev/null | grep -q "\"$${SOLR_COLLECTION}\""; then
            echo "wait-for-solr-collection: '$${SOLR_COLLECTION}' exists after $$n tries"
            exit 0
          fi
          n=$$((n + 1))
          if [ "$$n" -ge 120 ]; then
            echo "wait-for-solr-collection: giving up after $$n tries; starting biocache-service anyway"
            exit 0
          fi
          echo "wait-for-solr-collection: '$${SOLR_COLLECTION}' not listed yet, retry $$n in 3s"
          sleep 3
        done
    restart: "no"
