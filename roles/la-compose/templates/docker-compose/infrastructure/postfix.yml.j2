services:
  postfix:
    container_name: la_postfix
    profiles: [mail, full]
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    # Tagged, not bare (== :latest): 5.1.0 is the current release and the same digest
    # :latest resolves to today, Debian trixie -- which is what the `nc` healthcheck
    # below depends on. The alpine variant is a different image; do not swap the tag
    # for `5.1.0-alpine` without rechecking that healthcheck.
    image: boky/postfix:{{ postfix_version | default('5.1.0') }}
    restart: unless-stopped
    ports:
      - "25"
    # Every value quoted (and `$` doubled for compose's interpolation): the standard Postfix
    # relay form [smtp.example.org]:587 is a YAML flow sequence unquoted, and a password with
    # ': ', ' #', or a leading '*', '&', '!' or '%' breaks the file the same way; one broken
    # value fails every `docker compose` command of the host, not only postfix's.
    # An empty value is left out, not rendered "": unset is what boky expects. HOSTNAME=""
    # makes boky "delete" myhostname after it set up the relay, and its sed for that also
    # deletes the two lines after an active myhostname -- relayhost and smtp_sasl_auth_enable
    # when main.cf (an image VOLUME, kept across recreates) has one from an earlier start.
    # Unset, Docker gives the container hostname, as before the quoting.
{% set postfix_env = {
     'HOSTNAME': email_hostname | default(''),
     'RELAYHOST': email_sender_server | default(''),
     'RELAYHOST_USERNAME': email_sender | default(''),
     'RELAYHOST_PASSWORD': email_sender_password | default(''),
     'ALLOWED_SENDER_DOMAINS': email_allowed_domains | default(email_sender | default('') | regex_replace('^.*@', '')),
   } %}
    environment:
      TZ: {{ server_tz | default('UTC') | string | replace('$', '$$') | to_json }}
{% for k, v in postfix_env.items() if v | string | length > 0 %}
      {{ k }}: {{ v | string | replace('$', '$$') | to_json }}
{% endfor %}
      # ALLOWED_SENDER_DOMAINS derives from this deployment's sender address, never from a
      # hardcoded domain: email_allowed_domains is not emitted by the toolkit, so a literal
      # default here would apply to every deployment. Unset (boky refuses to start) beats
      # authorising someone else's domain.
    networks:
      default: {}
      {{ docker_network | default('internal') }}:
        aliases:
          - {{ mail_host | default('postfix') }}
    # nc, not telnet: boky/postfix is Debian trixie and ships no telnet, so the previous
    # `echo quit | telnet` test could only ever fail -> postfix reported UNHEALTHY on every
    # host of every deploy, and wait-for-health.sh burned its whole timeout waiting for it.
    # Nothing is written to the socket either: postfix answers an immediate QUIT with
    # "554 SMTP protocol synchronization", not with the banner. Reading with stdin closed
    # gets the 220 greeting; grep -q closes the pipe as soon as it matches.
    healthcheck:
      test: ["CMD-SHELL", "nc -w 3 127.0.0.1 25 </dev/null | grep -q '^220'"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
