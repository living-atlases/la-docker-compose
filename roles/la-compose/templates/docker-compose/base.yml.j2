---
# Docker Compose Base Template - Main Orchestrator
# This file includes all service definitions from separate files
# Services are organized by function: infrastructure/ and services/

name: la

# Combine standard Ansible groups with physical server detection groups
{% set all_groups = (group_names | union(physical_server_groups | default([]))) | reject('in', skip_services | default([])) | list %}

include:
{% if i18n.enabled and i18n.strategy == 'volume' and i18n.volume.source == 'init-container' %}
  - ./infrastructure/i18n.yml
{% endif %}
{% if 'nginx' in services_enabled %}
  - ./infrastructure/nginx.yml
{% endif %}
{% if 'branding' in all_groups %}
  - ./infrastructure/branding.yml
{% endif %}
{% if 'collectory' in services_enabled or 'ala_bie' in services_enabled or ('spatial' in services_enabled and (spatial_skin_active | default(false) | bool)) or (hub_instances | default([]) | rejectattr('is_portal') | rejectattr('has_branding') | list | length) > 0 %}
  # Order-independent branding readiness gate for commonui hubs (collectory, bie-hub) and, when the
  # Spatial skin is active, for la_spatial-skin-init (which fetches spatial-layout.gsp once branding
  # actually serves). Included on the spatial host only when the skin is on, so a branding-less
  # deploy never pays the poll timeout.
  #
  # A data hub WITHOUT a branding of its own depends on this unsuffixed gate (see the
  # brand_gate default in the service templates), so a host that carries only such a
  # hub needs it too -- otherwise every compose command on that host dies at parse
  # time on an undefined service, the #284/#285 failure class.
  - ./infrastructure/wait-for-branding.yml
{% endif %}
{% if docker_mail_development_mode | default(false) %}
{% if 'cas-servers' in all_groups or 'cas-servers' not in groups or (groups['cas-servers'] | length == 0) %}
  # Single cluster-wide mailhog on the cas/auth host (co-located with userdetails,
  # the account-registration mail producer). Other hosts reach it via `mailhog`
  # + extra_hosts + the published host port (see datastore_cluster_spec / mailhog.yml.j2).
  # Fallback: with no cas-servers group at all, keep the legacy per-host mailhog.
  - ./infrastructure/mailhog.yml
{% endif %}
{% else %}
  - ./infrastructure/postfix.yml
{% endif %}
{% if 'cas-servers' in all_groups or 'collectory' in all_groups or 'species-list' in all_groups or 'logger-service' in all_groups or 'alerts-service' in all_groups %}
  - ./infrastructure/mysql.yml
{% endif %}
{% if 'spatial' in all_groups or 'image-service' in all_groups or 'doi-service' in all_groups or 'data_quality_filter_service' in all_groups or 'geoserver' in all_groups or 'geonetwork' in all_groups %}
  - ./infrastructure/postgres.yml
{% endif %}
{% if 'cas-servers' in all_groups or 'ecodata' in all_groups or 'biocollect' in all_groups %}
  - ./infrastructure/mongodb.yml
{% endif %}
{% if 'ecodata' in all_groups %}
  # ClamAV antivirus daemon — ecodata scans file uploads against it (clamav:3310).
  - ./infrastructure/clamav.yml
{% endif %}
{% if 'solrcloud' in all_groups or 'solr' in all_groups %}
  - ./infrastructure/zookeeper.yml
  - ./infrastructure/solr.yml
{% endif %}
{% if 'cassandra5' in all_groups or 'cassandra3' in all_groups or 'cassandra' in all_groups %}
  - ./infrastructure/cassandra.yml
{% endif %}
{% if 'image-service' in all_groups or 'events' in all_groups or 'ecodata' in all_groups %}
  - ./infrastructure/elasticsearch.yml
{% endif %}
{% if 'doi-service' in all_groups %}
  # doi-service uses the ES TransportClient (grails-elasticsearch), incompatible with the shared
  # ES 8.x, so it gets a dedicated version-matched ES 7.x sidecar.
  - ./infrastructure/doi-elasticsearch.yml
{% endif %}
{% if enable_mysql | default(false) | bool or enable_postgres | default(false) | bool or enable_mongo | default(false) | bool %}
  - ./infrastructure/db-backup.yml
{% endif %}
{% if 'cas' in services_enabled %}
  - ./services/cas.yml
  - ./services/userdetails.yml
  - ./services/apikey.yml
  - ./services/cas-management.yml
{% endif %}
{% if 'species_lists' in services_enabled %}
  - ./services/species-list.yml
{% endif %}
{% if 'collectory' in services_enabled %}
  - ./services/collectory.yml
{% endif %}
{% if 'ala_bie' in services_enabled %}
  - ./services/bie-hub.yml
{% endif %}
{% if 'bie_index' in services_enabled %}
  - ./services/bie-index.yml
{% endif %}
{% if 'ala_hub' in services_enabled %}
  - ./services/biocache-hub.yml
{% endif %}
{# Data hubs: one set of front-ends per hub deployed on this host, each with its own
   containers and its own config mounts. hub_instances[0] is the portal and is already
   covered by the plain includes above, so only the suffixed instances are listed here
   and a deployment without hubs renders exactly the same file as before. #}
{% for inst in (hub_instances | default([])) if not inst.is_portal %}
{% if inst.use_records %}
  - ./services/biocache-hub{{ inst.suffix }}.yml
{% endif %}
{% if inst.use_species %}
  - ./services/bie-hub{{ inst.suffix }}.yml
{% endif %}
{% if inst.use_regions %}
  - ./services/regions{{ inst.suffix }}.yml
{% endif %}
{% if inst.use_branding %}
  - ./infrastructure/branding{{ inst.suffix }}.yml
{% endif %}
{# The readiness gate goes wherever a front-end of this hub runs, not only where the
   branding container does: it is a curl poll on the public URL, so it works from any
   host, and a spread hub's species front-end needs it just as much. #}
{% if inst.has_branding %}
  - ./infrastructure/wait-for-branding{{ inst.suffix }}.yml
{% endif %}
{% endfor %}
{% if 'biocache_service' in services_enabled %}
  # Order-independent gate: biocache-service caches the index field list at boot and keeps
  # an empty one forever if the Solr collection is not there yet. Only on the host that
  # runs biocache-service, so nobody else pays the poll.
  - ./infrastructure/wait-for-solr-collection.yml
  - ./services/biocache-service.yml
{% endif %}
{% if 'pipelines' in services_enabled %}
  - ./services/pipelines.yml
{% endif %}
{% if 'logger' in services_enabled %}
  - ./services/logger-service.yml
{% endif %}
{% if 'images' in services_enabled %}
  - ./services/image-service.yml
{% endif %}
{% if 'namematchingService' in services_enabled %}
  - ./services/namematching-service.yml
{% endif %}
{% if 'sensitiveDataService' in services_enabled %}
  - ./services/sensitive-data-service.yml
{% endif %}
{% if 'alerts' in services_enabled %}
  - ./services/alerts.yml
{% endif %}
{% if 'regions' in services_enabled %}
  - ./services/regions.yml
{% endif %}
{% if 'doi' in services_enabled %}
  - ./services/doi-service.yml
{% endif %}
{% if 'sds' in services_enabled %}
  - ./services/sds.yml
{% endif %}
{% if 'dataQuality' in services_enabled %}
  - ./services/data-quality-filter-service.yml
{% endif %}
{% if 'spatial' in services_enabled %}
  - ./services/spatial-hub.yml
{% endif %}
{% if 'spatial_service' in services_enabled %}
  - ./services/spatial-service.yml
{% endif %}
{% if 'geoserver' in services_enabled %}
  - ./services/geoserver.yml
{% endif %}
{% if 'geonetwork' in services_enabled %}
  - ./services/geonetwork.yml
{% endif %}
{% if 'ecodata' in services_enabled %}
  - ./services/ecodata.yml
{% endif %}
{% if 'biocollect' in services_enabled %}
  - ./services/biocollect.yml
{% endif %}
{% if 'biocollect' in services_enabled or 'pdfgen' in services_enabled %}
  # Self-hosted pdfgen (biocollect's PDF backend); replaces the public pdfgen.ala.org.au.
  - ./services/pdfgen.yml
{% endif %}
{% if 'sds-static-home' in all_groups %}
  - ./services/sds-static-home.yml
{% endif %}
{% if 'gatus' in all_groups %}
  - ./infrastructure/gatus.yml
{% endif %}

# Global networks and volumes
networks:
  {{ docker_network | default('internal') }}:
{% if deployment_type == 'swarm' %}
    external: true
{% else %}
    driver: bridge
{% endif %}

volumes:
{% if i18n.enabled and i18n.strategy == 'volume' %}
  {{ i18n.volume.name }}:
{% endif %}
{% for inst in (hub_instances | default([])) if not inst.is_portal and inst.use_branding %}
  la_branding-assets{{ inst.suffix }}:
    external: true
{% endfor %}
{% if use_la_site_certs | default(false) %}
  la-site-certs:
    external: true
{% endif %}
{% if 'cas-servers' in all_groups or 'collectory' in all_groups or 'species-list' in all_groups or 'logger-service' in all_groups or 'alerts-service' in all_groups %}
  la_mysql-data:
    external: true
{% endif %}
{% if 'spatial' in all_groups or 'image-service' in all_groups or 'doi-service' in all_groups or 'data_quality_filter_service' in all_groups or 'geoserver' in all_groups or 'geonetwork' in all_groups %}
  la_postgres-data:
    external: true
{% endif %}
{% if 'cas-servers' in all_groups or 'ecodata' in all_groups or 'biocollect' in all_groups %}
  la_mongodb-data:
    external: true
{% endif %}
{% if 'ecodata' in all_groups %}
  la_clamav-data:
    external: true
{% endif %}
{% if 'solrcloud' in all_groups or 'solr' in all_groups %}
  la_solr-data:
    external: true
{% endif %}
{% if 'cassandra5' in all_groups or 'cassandra3' in all_groups or 'cassandra' in all_groups %}
  la_cassandra-data:
    external: true
{% endif %}
{% if 'image-service' in all_groups or 'events' in all_groups or 'ecodata' in all_groups %}
  la_elasticsearch-data:
    external: true
{% endif %}
{% if 'doi-service' in all_groups %}
  la_doi-elasticsearch-data:
    external: true
{% endif %}
{% if 'gatus' in all_groups %}
  la_gatus-data:
    external: true
{% endif %}
{% if 'branding' in all_groups %}
  la_branding-assets:
    external: true
{% endif %}
