# Rendered by la-compose onto the pipelines host next to the overlay compose, and
# merged into it via `docker compose -f docker-compose.airflow.yml -f <this>`.
#
# Gives the overlay's Airflow containers the SAME cross-host /etc/hosts entries that
# every other la-docker-compose consumer gets (docker_extra_hosts_dict: public
# service domains -> owning host private IP, plus datastores solr/zookeeper/... ->
# host IP). Without this la_airflow has an empty ExtraHosts and resolves the public
# service domains to the LOCAL nginx (wrong host) -> 404; with it, the DAGs reach
# biocache/collectory (public URLs) and solr/zookeeper cross-host, exactly like
# la_gatus_service does on the same host.
#
# Generic: docker_extra_hosts_dict is per-host computed from the inventory topology.
# Single-host: the dict is empty -> extra_hosts: {} -> no-op.
#
# Also grants the containers the docker socket's group, so the NO-AWS shim can run
# `docker exec la_pipelines` over the bind-mounted socket. The images run as uid 50000
# gid 0 and the socket is root:docker 0660, so without this EVERY step fails with
# "permission denied ... dial unix /var/run/docker.sock" — fast and opaque, since the
# shim only surfaces a CalledProcessError. The gid is read from the target host
# (docker's gid is not portable across distros); if the stat is unavailable the key is
# omitted and behaviour is exactly as before.
#
# Finally, mounts the pipelines-airflow dags/ tree at the SAME path la_pipelines gets it
# (/opt/pa-dags) and points PA_DAGS_DIR at it. The DAGs call helper scripts and CLIs by
# absolute /tmp path, which on EMR the cluster's BootstrapActions stage from S3; our shim
# has no cluster to bootstrap, so the overlay's translator repoints those references at
# this mount. One path in both containers keeps a step's command valid wherever it runs.
#
# And mounts the pipelines data directories at the SAME absolute paths la_pipelines sees
# them, so the overlay can perform the DAGs' s3-dist-cp steps for real (MinIO <-> shared
# volume) with boto3, in-process. Identical paths on both sides mean there is no
# host/container path map to drift: `hdfs:///pipelines-all-datasets` resolves to the same
# directory whoever reads it. Only these paths are mounted, not /data wholesale -- that
# holds every other service's data.
{% if airflow_docker_sock is defined and airflow_docker_sock.stat is defined and airflow_docker_sock.stat.exists %}
{%   set _sock_gid = [airflow_docker_sock.stat.gid | string] %}
{% else %}
{%   set _sock_gid = [] %}
{% endif %}
services:
  airflow-init:
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    environment:
      PA_DAGS_DIR: /opt/pa-dags
    volumes:
      - {{ docker_compose_data_dir }}/pipelines-airflow/dags:/opt/pa-dags:ro
      - {{ data_dir | default('/data') }}/la-pipelines:/data/la-pipelines
      - {{ data_dir | default('/data') }}/la-pipelines/all-datasets:/pipelines-all-datasets
      - {{ data_dir | default('/data') }}/la-pipelines/species:/pipelines-species
      - {{ data_dir | default('/data') }}/la-pipelines/jackknife:/pipelines-jackknife
      - {{ data_dir | default('/data') }}/la-pipelines/clustering:/pipelines-clustering
      - {{ data_dir | default('/data') }}/la-pipelines/outlier:/pipelines-outlier
{% if _sock_gid %}
    group_add: {{ _sock_gid | to_json }}
{% endif %}
  airflow-webserver:
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    environment:
      PA_DAGS_DIR: /opt/pa-dags
    volumes:
      - {{ docker_compose_data_dir }}/pipelines-airflow/dags:/opt/pa-dags:ro
      - {{ data_dir | default('/data') }}/la-pipelines:/data/la-pipelines
      - {{ data_dir | default('/data') }}/la-pipelines/all-datasets:/pipelines-all-datasets
      - {{ data_dir | default('/data') }}/la-pipelines/species:/pipelines-species
      - {{ data_dir | default('/data') }}/la-pipelines/jackknife:/pipelines-jackknife
      - {{ data_dir | default('/data') }}/la-pipelines/clustering:/pipelines-clustering
      - {{ data_dir | default('/data') }}/la-pipelines/outlier:/pipelines-outlier
{% if _sock_gid %}
    group_add: {{ _sock_gid | to_json }}
{% endif %}
  airflow-scheduler:
    extra_hosts: {{ docker_extra_hosts_dict | default({}) | to_json }}
    environment:
      PA_DAGS_DIR: /opt/pa-dags
    volumes:
      - {{ docker_compose_data_dir }}/pipelines-airflow/dags:/opt/pa-dags:ro
      - {{ data_dir | default('/data') }}/la-pipelines:/data/la-pipelines
      - {{ data_dir | default('/data') }}/la-pipelines/all-datasets:/pipelines-all-datasets
      - {{ data_dir | default('/data') }}/la-pipelines/species:/pipelines-species
      - {{ data_dir | default('/data') }}/la-pipelines/jackknife:/pipelines-jackknife
      - {{ data_dir | default('/data') }}/la-pipelines/clustering:/pipelines-clustering
      - {{ data_dir | default('/data') }}/la-pipelines/outlier:/pipelines-outlier
{% if _sock_gid %}
    group_add: {{ _sock_gid | to_json }}
{% endif %}
