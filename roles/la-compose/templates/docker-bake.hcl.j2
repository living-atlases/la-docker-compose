# Docker Bake configuration for Living Atlas branding builders
# Generated by la-compose ansible role
# This file is used to build branding images independently of docker-compose
# to avoid container metadata tracking issues when recreating containers
#
# One target per branding: the portal's (empty suffix, target "branding") plus one
# per data hub that declares a branding_source of its own. The list is built by
# tasks/stage-branding-source.yml as it stages each source, so a deployment without
# hubs produces exactly the single-target file it produced before.

variable "NODE_VERSION" {
  default = "{{ branding_node_version | default('18') }}"
}

{% for b in (branding_render_list | default([{'suffix': '', 'source': branding_source | default(''), 'is_git': branding_is_git_url | default(false), 'build_source': branding_build_source | default('local'), 'git_ref': branding_git_ref | default('HEAD'), 'version': branding_version | default('latest')}])) %}
{% set id = 'branding' ~ (b.suffix | replace('-', '_')) %}
variable "BUILD_SOURCE{{ b.suffix | upper | replace('-', '_') }}" {
  default = "{{ b.build_source }}"
}

{% if b.is_git %}
variable "GIT_URL{{ b.suffix | upper | replace('-', '_') }}" {
  default = "{{ b.source }}"
}

variable "GIT_REF{{ b.suffix | upper | replace('-', '_') }}" {
  default = "{{ b.git_ref }}"
}
{% endif %}

target "{{ id }}" {
  dockerfile = "Dockerfile"
  context = "{{ docker_compose_data_dir }}/dockerfiles/branding{{ b.suffix }}"
  target = "builder-production"
  args = {
    BUILD_SOURCE = "${BUILD_SOURCE{{ b.suffix | upper | replace('-', '_') }}}"
    NODE_VERSION = "${NODE_VERSION}"
{% if b.is_git %}
    GIT_URL = "${GIT_URL{{ b.suffix | upper | replace('-', '_') }}}"
    GIT_REF = "${GIT_REF{{ b.suffix | upper | replace('-', '_') }}}"
{% endif %}
  }
  tags = ["branding-builder{{ b.suffix }}:{{ b.version }}"]
  cache-to = ["type=inline"]
  platforms = ["linux/amd64"]
  output = ["type=docker"]
}

{% endfor %}
