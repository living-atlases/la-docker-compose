#!/bin/sh
# Geoserver functional init for the ALA spatial stack — container adaptation of the ala-install
# `geoserver.sh`. Runs INSIDE the la_geoserver container via `docker exec` (the GeoServer REST API
# is reached at localhost), so no host port publication is required (works on multi-host where the
# container only `expose`s 8080).
#
# Properties:
#  - Idempotent: every create is guarded by a prior GET; PUTs are naturally idempotent. Safe to
#    re-run on every `ansiblew`.
#  - Best-effort: no `set -e`, every curl `|| true`, always `exit 0`. A transient REST/DB hiccup
#    must never fail the deploy — geoserver liveness is gated separately (healthcheck + depends_on).
#  - Self-contained: assets (SLDs, marker.png, scale.xml, featuretype XMLs) are staged on the host
#    and docker-cp'd into {{ '${DIR}' }}, so the container needs no outbound internet.
#
# The admin password is already set by the kartoza image (GEOSERVER_ADMIN_PASSWORD), so unlike the
# upstream script we do NOT change it here — we just authenticate with it.
set -u

GS="http://localhost:{{ geoserver_port | default('8080') }}/geoserver"
GSUSER="{{ geoserver_username | default('admin') }}"
GSPASS="{{ geoserver_password | default('geoserver') }}"
DIR="$(cd "$(dirname "$0")" && pwd)"

# HTTP status of an authenticated GET (used as an existence guard).
code() { curl -s -o /dev/null -w '%{http_code}' -u "${GSUSER}:${GSPASS}" "$1"; }
# Authenticated curl wrapper (best-effort).
gs() { curl -s -u "${GSUSER}:${GSPASS}" "$@" || true; }

echo "== geoserver-init: workspace ALA =="
# Drop GeoServer's stock sample workspaces (harmless if already absent).
for ws in nurc cite it.geosolutions.html sde sf tiger topp; do
  gs -XDELETE "${GS}/rest/workspaces/${ws}?recurse=true" -o /dev/null
done
if [ "$(code "${GS}/rest/workspaces/ALA")" != "200" ]; then
  gs -XPOST -H "Content-type: text/xml" \
    -d "<workspace><name>ALA</name></workspace>" "${GS}/rest/workspaces"
fi

echo "== geoserver-init: datastore LayersDB (PostGIS -> layersdb) =="
LAYERSDB_HOST="{{ layers_db_hostname | default('postgres') }}"
LAYERSDB_XML="<dataStore><name>LayersDB</name><connectionParameters>\
<host>${LAYERSDB_HOST}</host>\
<port>{{ layers_db_port | default('5432') }}</port>\
<database>{{ layers_db_name | default('layersdb') }}</database>\
<schema>public</schema>\
<user>{{ layers_db_username | default('layers') }}</user>\
<passwd>{{ layers_db_password }}</passwd>\
<dbtype>postgis</dbtype>\
</connectionParameters></dataStore>"
if [ "$(code "${GS}/rest/workspaces/ALA/datastores/LayersDB")" != "200" ]; then
  gs -XPOST -H "Content-type: text/xml" -d "${LAYERSDB_XML}" "${GS}/rest/workspaces/ALA/datastores"
else
  # A data dir migrated from a VM keeps the VM's store, pointing at host=localhost: inside the
  # container that is not PostGIS, and every Objects/Points request fails. Repoint it.
  cur_host=$(gs "${GS}/rest/workspaces/ALA/datastores/LayersDB.xml" | sed -n 's|.*<entry key="host">\([^<]*\)</entry>.*|\1|p' | head -1)
  if [ -n "${cur_host}" ] && [ "${cur_host}" != "${LAYERSDB_HOST}" ]; then
    echo "LayersDB host ${cur_host} -> ${LAYERSDB_HOST}"
    gs -XPUT -H "Content-type: text/xml" -d "${LAYERSDB_XML}" "${GS}/rest/workspaces/ALA/datastores/LayersDB"
  fi
fi

echo "== geoserver-init: URL check for spatial-service external uploads =="
# spatial-service publishes a shapefile/GeoTIFF with PUT .../external.shp|external.geotiff and the
# file's path in the body. Since GeoServer 2.27 a file: URL in that body goes through the URL checks
# (Security > URL checks); they are on by default and, with no rule, refuse everything, so every
# spatial_add_layer / layer upload fails with 400 "Failed to locate the input file file:///...".
# A bare path skips the check (RESTUtils.handleEXTERNALUpload tries new File(body) first) but
# spatial-service sends file://. Allow only the two directories the stack shares (URL.toString()
# renders file:///x as file:/x, hence the optional slashes). Never touches rules already there.
URLCHECK="{{ geoserver_url_check_name | default('la-compose-data') }}"
if [ "$(code "${GS}/rest/urlchecks/${URLCHECK}")" != "200" ]; then
  gs -XPOST -H "Content-type: text/xml" \
    -d "<regexUrlCheck><name>${URLCHECK}</name><description>spatial-service external uploads (managed by la-docker-compose)</description><enabled>true</enabled><regex>{{ geoserver_url_check_regex | default('file:/{1,3}data/(spatial-data|geoserver_data_dir)/(?!.*\.\.).*') }}</regex></regexUrlCheck>" \
    "${GS}/rest/urlchecks"
fi

echo "== geoserver-init: styles =="
for s in distributions_style envelope_style alastyles points_style; do
  if [ "$(code "${GS}/rest/styles/${s}")" != "200" ]; then
    gs -XPOST -H "Content-type: text/xml" \
      -d "<style><name>${s}</name><filename>${s}.sld</filename></style>" "${GS}/rest/styles"
  fi
  if [ -f "${DIR}/${s}.sld" ]; then
    gs -XPUT -H "Content-type: application/vnd.ogc.sld+xml" \
      -d @"${DIR}/${s}.sld" "${GS}/rest/styles/${s}"
  fi
done

echo "== geoserver-init: feature types (Objects / Distributions / Points) =="
for ft in Objects:geoserver.objects.xml Distributions:geoserver.distributions.xml Points:geoserver.points.xml; do
  name="${ft%%:*}"; file="${ft##*:}"
  if [ "$(code "${GS}/rest/workspaces/ALA/datastores/LayersDB/featuretypes/${name}")" != "200" ] \
     && [ -f "${DIR}/${file}" ]; then
    gs -XPOST -H "Content-type: text/xml" \
      -T "${DIR}/${file}" "${GS}/rest/workspaces/ALA/datastores/LayersDB/featuretypes"
  fi
done

echo "== geoserver-init: fallback layers (listed by the layers database, not published by GeoServer) =="
# The layers database lists a layer through its field, and the portal's layer tree and WMS calls
# ask GeoServer for ALA:<name>. The upstream layersdb.sql seeds contextual layers (and a data dir
# restored without its GeoServer config has others) whose GeoServer layer does not exist, so the
# hub lists a layer that answers LayerNotDefined. Each such layer is published here as a SQL view
# over the objects table (the same table, and the same technique, as ALA:Objects): its own
# polygons, drawn by the LayersDB store. A layer that GeoServer already publishes, from a
# shapefile store or anything else, is never touched. fallback-layers.txt is "<name> <fid>" lines
# written by the playbook from the layers database; missing or empty means nothing to do.
if [ -f "${DIR}/fallback-layers.txt" ]; then
  while read -r lname lfid; do
    [ -n "${lname}" ] && [ -n "${lfid}" ] || continue
    case "${lname}${lfid}" in *[!A-Za-z0-9_]*) echo "FALLBACK skipped (unsafe name): ${lname} ${lfid}"; continue ;; esac
    if [ "$(code "${GS}/rest/layers/ALA:${lname}")" = "200" ]; then continue; fi
    cat > "${DIR}/fallback-${lname}.xml" <<XML
<featureType>
  <name>${lname}</name>
  <nativeName>${lname}</nativeName>
  <title>${lname}</title>
  <srs>EPSG:4326</srs>
  <nativeBoundingBox><minx>-180.0</minx><maxx>180.0</maxx><miny>-90.0</miny><maxy>90.0</maxy></nativeBoundingBox>
  <latLonBoundingBox><minx>-180.0</minx><maxx>180.0</maxx><miny>-90.0</miny><maxy>90.0</maxy></latLonBoundingBox>
  <projectionPolicy>FORCE_DECLARED</projectionPolicy>
  <enabled>true</enabled>
  <metadata>
    <entry key="JDBC_VIRTUAL_TABLE">
      <virtualTable>
        <name>${lname}</name>
        <sql>select pid, name, the_geom from objects where fid = '${lfid}'</sql>
        <escapeSql>false</escapeSql>
        <geometry><name>the_geom</name><type>Geometry</type><srid>4326</srid></geometry>
      </virtualTable>
    </entry>
  </metadata>
</featureType>
XML
    gs -XPOST -H "Content-type: text/xml" -T "${DIR}/fallback-${lname}.xml" \
      "${GS}/rest/workspaces/ALA/datastores/LayersDB/featuretypes"
    echo "FALLBACK layer ALA:${lname} (${lfid}): $(code "${GS}/rest/layers/ALA:${lname}")"
  done < "${DIR}/fallback-layers.txt"
fi

echo "== geoserver-init: assign default styles to layers =="
gs -XPUT -H 'Content-type: text/xml' -d '<layer><defaultStyle><name>distributions_style</name><workspace>ALA</workspace></defaultStyle></layer>' "${GS}/rest/layers/ALA:Objects"
gs -XPUT -H 'Content-type: text/xml' -d '<layer><defaultStyle><name>distributions_style</name><workspace>ALA</workspace></defaultStyle></layer>' "${GS}/rest/layers/ALA:Distributions"
gs -XPUT -H 'Content-type: text/xml' -d '<layer><defaultStyle><name>points_style</name><workspace>ALA</workspace></defaultStyle></layer>' "${GS}/rest/layers/ALA:Points"

if [ -f "${DIR}/marker.png" ]; then
  echo "== geoserver-init: marker icon =="
  gs -XPUT -H 'Content-type: image/png' -d @"${DIR}/marker.png" "${GS}/rest/resource/styles/marker.png"
fi

if [ -f "${DIR}/scale.xml" ]; then
  echo "== geoserver-init: WMS scale layout =="
  mkdir -p "${GEOSERVER_DATA_DIR:-/data/geoserver_data_dir}/layout"
  cp "${DIR}/scale.xml" "${GEOSERVER_DATA_DIR:-/data/geoserver_data_dir}/layout/scale.xml" || true
fi

echo "== geoserver-init: done — result codes =="
echo "RESULT workspace ALA:        $(code "${GS}/rest/workspaces/ALA")"
echo "RESULT datastore LayersDB:   $(code "${GS}/rest/workspaces/ALA/datastores/LayersDB")"
echo "RESULT featuretype Objects:  $(code "${GS}/rest/workspaces/ALA/datastores/LayersDB/featuretypes/Objects")"
echo "RESULT featuretype Points:   $(code "${GS}/rest/workspaces/ALA/datastores/LayersDB/featuretypes/Points")"
exit 0
