# Generated from inventory at {{ ansible_date_time.iso8601 }}
# Database initialization passwords from la-test-local-passwords.ini
# DO NOT COMMIT - contains sensitive passwords

MYSQL_ROOT_PASSWORD={{ mysql_root_password }}
MYSQL_COLLECTORY_PASSWORD={{ collectory_db_password }}
MONGODB_ROOT_PASSWORD={{ mongodb_root_password }}
MONGODB_ROOT_USERNAME={{ mongodb_root_username }}
POSTGRES_PASSWORD={{ postgresql_password }}

# CAS Database Configuration (for db-cas-init script)
CAS_DB_NAME={{ cas_db_name | default('emmet') }}
CAS_DB_USERNAME={{ cas_db_username | default('cas') }}
CAS_DB_PASSWORD={{ cas_db_password | default('password') }}

# CAS Admin Account (optional - if defined, admin account will be created by db-cas-init)
{% if cas_first_admin_email is defined %}
CAS_FIRST_ADMIN_EMAIL={{ cas_first_admin_email }}
CAS_FIRST_ADMIN_BCRYPT_PASSWORD='{{ cas_first_admin_bcrypt_password | default('') }}'
CAS_FIRST_ADMIN_TEMP_AUTH_KEY={{ cas_first_admin_temp_auth_key | default('') }}
{% endif %}

# Docker Compose profiles - controls which service groups are started
COMPOSE_PROFILES={{ compose_profiles | default('full') }}
{% if use_airflow | default(false) | bool %}

# Airflow admin password for the pipelines-airflow overlay (seed.sh seeds the admin user
# with it). Single-quoted so a passphrase with $ or # is taken literally by compose.
# NOTE: seed.sh creates the admin only on first boot (|| true); to rotate see the overlay README.
AIRFLOW_ADMIN_PASSWORD='{{ airflow_admin_password | default('admin') }}'
{% endif %}

# Java Options for ALL known Java services (those with log_config_filename in docker-services-desc).
# Generated regardless of whether the service is currently enabled, so docker-compose never
# warns about missing variables even with partial stacks or stale compose files.
# Mirrors the JVM tuning applied by ala-install on VM deployments (headless, memory, log4j2 fix,
# logging config path). To customise a service's memory, set in inventory:
#   <service>_max_memory: "4g"   (default: 2g)
#   <service>_min_memory: "2g"   (default: 1g)
#   java_security_opts: "..."    (default: -Dlog4j2.formatMsgNoLookups=true)
#   <service>_stack_size: "512k" (default: the desc's stack_size, else the JVM default)
# <service> is the docker_services_desc KEY, not the compose service name: images, logger,
# spatial, spatial_service, dataQuality, doi. So it is images_max_memory, not
# image_service_max_memory.
#
# Two flags come from docker-services-desc rather than the inventory: `stack_size` (-Xss) and
# `extra_config_name`, appended to -Dspring.config.name so a role-generated per-service
# <name>.properties is actually read.
#
# This must stay a superset of what the image itself puts in ENV JAVA_OPTS
# (la-docker-images build.py, "Add Spring Boot config location and name defaults"),
# because `JAVA_OPTS: ${<SERVICE>_JAVA_OPTS}` in a service REPLACES that ENV rather
# than adding to it. Until la-docker-images#3 the point was moot: the image CMD had
# every flag frozen into it at Dockerfile generation time, so the spring.config
# settings survived no matter what this file emitted -- and the memory settings here
# were ignored for the same reason. With the fixed images the CMD is
# `java ${JAVA_OPTS} -jar ...`, so anything missing from here is simply not passed,
# and a service would start without its /data/<artifact>/config overrides.
# Mapping: docker_services_desc key → env var prefix (special cases below)
{% set service_env_name_map = {
  'ala_hub': 'BIOCACHE_HUB',
  'ala_bie': 'BIE_HUB'
} -%}
{% for service, java_opts in service_java_opts_dict.items() | default([]) %}
{%- set service_name = service_env_name_map.get(service, service.upper().replace('-', '_')) -%}
{%- set extra_params = (service_extra_params | default({})).get(service, []) -%}
{%- set service_version_var = service.replace('-', '_') + '_version' -%}
{%- set service_version = vars.get(service_version_var, 'develop') -%}
{%- set log_config_file = docker_services_desc.get(service, {}).get('log_config_filename', '') -%}
{%- set data_dir_name = docker_services_desc.get(service, {}).get('artifacts', service) -%}
{%- set extra_config_name = docker_services_desc.get(service, {}).get('extra_config_name', '') -%}
{%- set stack_size = vars.get(service.replace('-', '_') + '_stack_size', docker_services_desc.get(service, {}).get('stack_size', '')) -%}
{{ service_name }}_JAVA_OPTS={{ java_opts }}{% if stack_size %} -Xss{{ stack_size }}{% endif %}{% for param in extra_params %} -D{{ param.key }}={{ param.value }}{% endfor %} -Dhttp.agent={{ service }}/{{ service_version }}{% if log_config_file %} -Dlogging.config=/data/{{ data_dir_name }}/config/{{ log_config_file }}{% endif %} -Dspring.config.additional-location=/data/{{ data_dir_name }}/config/ -Dspring.config.name=application,application-local-config{% if extra_config_name %},{{ extra_config_name }}{% endif %}

{% endfor %}

