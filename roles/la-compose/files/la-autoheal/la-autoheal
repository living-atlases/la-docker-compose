#!/bin/bash
# Managed by Ansible (la-compose role, tasks/autoheal.yml; docker_autoheal). Do not edit.
#
# Restarts the LA containers Docker reports as unhealthy. `restart: unless-stopped` only
# acts when the process dies, and after a Docker or host restart the stack can come back
# alive but broken: biocache-service with its JVM up and no application context (luke
# timed out against a cold Solr), and the hubs in the i18n race (every page a 500). Seen on
# gbif.es on 2026-10-21, when unattended-upgrades updated docker-ce and restarted everything.
#
# Rules:
#  - only this stack's containers: those whose name matches LA_AUTOHEAL_MATCH (default ^la_)
#    plus those compose started from LA_AUTOHEAL_COMPOSE_DIR. A service declared with a
#    replica count has no container_name, so its containers are <project>-<service>-N and
#    do NOT match ^la_: without the second half autoheal would quietly stop recovering
#    them, which with the nginx replica drop-in (docker_nginx_replica_failover) leaves a
#    permanently degraded portal that looks healthy, because nginx hides the 5xx.
#    The second half is read from docker, not from this file, on purpose: a fast deploy does
#    not rewrite /etc/default/la-autoheal, so a list of replicated services kept there would
#    go stale exactly when a fast deploy turned replicas on. Today it selects nothing new:
#    every container_name in the repo's templates starts with la_, as do the only two
#    inventory overrides, and the airflow overlay runs from its own directory
#    (<compose dir>/overlay/pipelines-airflow/compose), so its label does not match;
#  - biocache-service first: while it is unhealthy the hubs that depend on it wait. This only
#    sees THIS host: a hub whose biocache-service runs on another host is handled on its own;
#  - at most one restart per container every LA_AUTOHEAL_GRACE seconds (let it boot);
#  - at most LA_AUTOHEAL_MAX restarts per container and hour; after that it only logs (three
#    failed boots means the problem is not the boot, and someone has to look);
#  - nothing while a deploy is in progress (la-compose touches LA_AUTOHEAL_DEPLOY_MARKER for
#    the length of a deploy, and wait-for-health.sh does its own converge restarts). A marker
#    older than LA_AUTOHEAL_DEPLOY_MARKER_MAX_AGE_MIN minutes, left by a deploy that died,
#    stops blocking;
#  - optional application probes (LA_AUTOHEAL_PROBES, one "container url" per line, url as
#    seen inside the container): a healthy container whose url answers 5xx or nothing in
#    LA_AUTOHEAL_PROBE_FAILS consecutive passes counts as unhealthy. For checks a portal
#    wants on top of the compose healthchecks.
# Everything goes to the journal with the tag la-autoheal.
#
#   la-autoheal --dry-run      # what it would do, without restarting
#   journalctl -t la-autoheal
set -u
DEFAULTS=${LA_AUTOHEAL_DEFAULTS:-/etc/default/la-autoheal}
# shellcheck disable=SC1090
[ -r "$DEFAULTS" ] && . "$DEFAULTS"
MATCH=${LA_AUTOHEAL_MATCH:-^la_}
# The directory `docker compose up` runs in. Compose labels every container it starts with
# com.docker.compose.project.working_dir, so this selects exactly this stack, by the one
# thing we know for certain, without having to predict the project name compose derives
# from that directory (no --project-name is passed at deploy time). Another compose project
# on the host (an overlay with its own directory) is left alone.
COMPOSE_DIR=${LA_AUTOHEAL_COMPOSE_DIR:-/data/docker-compose}
COMPOSE_DIR=${COMPOSE_DIR%/}  # the label carries no trailing slash; one here would never match
GRACE=${LA_AUTOHEAL_GRACE:-600}
MAX=${LA_AUTOHEAL_MAX:-3}
FIRST=${LA_AUTOHEAL_FIRST:-la_biocache-service}
# Data hub instances are la_<hub>-<suffix> (la_biocache-hub-testhub): the suffix is allowed.
# FIRST and DEPENDENT are container NAMES on purpose: none of those services is a candidate
# for replication (the hubs carry user sessions, biocache-service shares a writable download
# queue), so they keep their container_name. Replicating one of them would mean moving these
# two to the com.docker.compose.service label first.
DEPENDENT=${LA_AUTOHEAL_DEPENDENT:-^la_(biocache-hub|bie-hub|bie-index|regions|collectory|species-list|spatial-hub)(-.+)?$}
STATE=${LA_AUTOHEAL_STATE:-/var/lib/la-autoheal}
PROBES=${LA_AUTOHEAL_PROBES:-}
PROBE_FAILS=${LA_AUTOHEAL_PROBE_FAILS:-3}
MARKER=${LA_AUTOHEAL_DEPLOY_MARKER:-/run/la-compose-deploy.marker}
MARKER_MAX_AGE_MIN=${LA_AUTOHEAL_DEPLOY_MARKER_MAX_AGE_MIN:-360}
DRY=${1:-}
now=${LA_AUTOHEAL_NOW:-$(date +%s)}
log() { logger -t la-autoheal -- "$*"; [ -n "$DRY" ] && echo "$*"; }

# Every minute during a deploy: say it only when asked, not in the journal.
if [ -n "$(find "$MARKER" -maxdepth 0 -mmin "-${MARKER_MAX_AGE_MIN}" 2>/dev/null)" ]; then
  [ -n "$DRY" ] && echo "a deploy is in progress ($MARKER): nothing to do"
  exit 0
fi

mkdir -p "$STATE"
mapfile -t unhealthy < <({
  docker ps --filter health=unhealthy --format '{{.Names}}' | grep -E "$MATCH"
  docker ps --filter health=unhealthy \
    --filter "label=com.docker.compose.project.working_dir=$COMPOSE_DIR" --format '{{.Names}}'
} | sort -u)

# Probes only on healthy containers (the others are already in the list).
while read -r pc purl; do
  [ -z "${pc:-}" ] && continue
  [ "$(docker inspect -f '{{.State.Health.Status}}' "$pc" 2>/dev/null)" = healthy ] || continue
  code=$(docker exec "$pc" curl -s -m 20 -o /dev/null -w '%{http_code}' "$purl" 2>/dev/null)
  pf="$STATE/$pc.probe"
  if [ -z "$code" ] || [ "$code" = 000 ] || [ "${code:0:1}" = 5 ]; then
    k=$(( $(cat "$pf" 2>/dev/null || echo 0) + 1 ))
    # A dry run reports the attempt it would count but leaves the count alone.
    [ -n "$DRY" ] || echo "$k" > "$pf"
    log "$pc healthy but $purl answers ${code:-nothing} ($k of $PROBE_FAILS)"
    [ "$k" -ge "$PROBE_FAILS" ] && unhealthy+=("$pc")
  else
    [ -n "$DRY" ] || rm -f "$pf"
  fi
done <<< "$PROBES"

[ ${#unhealthy[@]} -eq 0 ] && exit 0
mapfile -t unhealthy < <(printf '%s\n' "${unhealthy[@]}" | sort -u)

first_bad=0
for c in "${unhealthy[@]}"; do [ "$c" = "$FIRST" ] && first_bad=1; done

for c in "${unhealthy[@]}"; do
  if [ $first_bad = 1 ] && [ "$c" != "$FIRST" ] && [[ "$c" =~ $DEPENDENT ]]; then
    log "$c unhealthy: waiting for $FIRST to be healthy first"
    continue
  fi
  f="$STATE/$c"
  [ -n "$DRY" ] || touch "$f"
  # restarts in the last hour
  recent=$(awk -v t=$((now - 3600)) '$1 > t' "$f" 2>/dev/null)
  n=$(printf '%s\n' "$recent" | grep -c . || true)
  last=$(printf '%s\n' "$recent" | tail -1)
  if [ -n "$last" ] && [ $((now - last)) -lt "$GRACE" ]; then
    continue
  fi
  if [ "$n" -ge "$MAX" ]; then
    log "ERROR $c still unhealthy after $n restarts in an hour: not restarting it again, it needs a look"
    continue
  fi
  if [ -n "$DRY" ]; then
    log "(dry) would restart $c"
    continue
  fi
  log "restarting $c (unhealthy; restart $((n + 1)) of $MAX in the last hour)"
  rm -f "$STATE/$c.probe"
  printf '%s\n' "$recent" | grep . > "$f.tmp" || true
  echo "$now" >> "$f.tmp"; mv "$f.tmp" "$f"
  docker restart "$c" >/dev/null 2>&1 || log "ERROR docker restart $c failed"
done
